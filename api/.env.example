# Obligatorio en producción: si falta, el servidor no arranca.
JWT_SECRET=cambia-esto-por-32-bytes-aleatorios

# Base de datos. Con docker compose la inyecta el propio compose.
DATABASE_URL=postgres://curso:curso@localhost:5432/curso

# Origen del frontend, para CORS.
WEB_ORIGIN=http://localhost:4321
PORT=8787

# Mercado Pago. Sin estas dos, /api/payments/... responde 501 y nadie puede pagar.
# MP_ACCESS_TOKEN=
# MP_PUBLIC_KEY=
# MP_WEBHOOK_SECRET=

# Almacén de medios (`media-store`, repositorio aparte).
# Sin IA_SECRETO las rutas /api/medios/* responden 503 y el resto del curso sigue
# igual: no se finge un almacén que no está, igual que no se finge un pago.
MEDIA_URL=http://127.0.0.1:8792
# IA_SECRETO=
