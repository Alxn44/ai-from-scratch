---
import { icon } from '../lib/icons';
import { initials, type User } from '../lib/session';
import { t, resolveLang, IDIOMAS, NOMBRE_IDIOMA, type Lang } from '../lib/i18n';
import { TOKENS, LANG_FX } from '../lib/theme-css';
interface Props { user: User; title: string; crumb: string; active: string; }
const { user, title, crumb, active } = Astro.props;

// Idioma efectivo: si la preferencia es 'auto' se resuelve en el servidor con
// Accept-Language (el idioma del equipo) — así no hay parpadeo de contenido.
const lang: Lang = resolveLang(user.lang, Astro.request);
const L = t(lang);
// El tema 'auto' lo resuelve el CSS con prefers-color-scheme, sin JS y sin parpadeo.
const themeAttr = user.theme;

const NAV = [
  { href: '/panel',     ic: 'home',   key: 'panel',   label: L.nav.panel,   roles: ['student', 'tutor', 'admin'] },
  { href: '/curso',     ic: 'book',   key: 'curso',   label: L.nav.curso,   roles: ['student', 'tutor', 'admin'] },
  { href: '/chat',      ic: 'spark',  key: 'chat',    label: L.nav.chat,    roles: ['student', 'tutor', 'admin'] },
  { href: '/logros',    ic: 'chart',  key: 'logros',  label: L.nav.logros,  roles: ['student', 'tutor', 'admin'] },
  { href: '/ranking',   ic: 'chart',  key: 'ranking', label: L.nav.ranking, roles: ['student', 'tutor', 'admin'] },
  { href: '/ligas',     ic: 'chart',  key: 'ligas',   label: L.nav.ligas,   roles: ['student', 'tutor', 'admin'] },
  { href: '/tutor',     ic: 'users',  key: 'cohorte', label: L.nav.cohorte, roles: ['tutor', 'admin'] },
  { href: '/admin',     ic: 'shield', key: 'admin',   label: L.nav.admin,   roles: ['admin'] },
  { href: '/perfil',    ic: 'user',   key: 'perfil',  label: L.nav.perfil,  roles: ['student', 'tutor', 'admin'] },
  { href: '/ajustes',   ic: 'gear',   key: 'ajustes', label: L.nav.ajustes, roles: ['student', 'tutor', 'admin'] },
].filter((n) => n.roles.includes(user.role));

const ROL: Record<string, string> = { student: L.ui.rolStudent, tutor: L.ui.rolTutor, admin: L.ui.rolAdmin };
---
<!doctype html>
<html lang={lang} data-theme={themeAttr}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title} · IA desde cero</title>
  <style is:global set:html={TOKENS + LANG_FX}></style>
  <style is:global>
    *{box-sizing:border-box}
    body{margin:0;background:var(--bg);font-family:var(--f);color:var(--l1);-webkit-font-smoothing:antialiased;transition:background .2s,color .2s}
    a{color:var(--ac);text-decoration:none}
    a:hover{color:#409CFF}
    .lbl{font:500 10px/1 var(--m);letter-spacing:.18em;text-transform:uppercase;color:var(--l3);margin:0}
    .eb{font:600 10px/1 var(--m);letter-spacing:.22em;text-transform:uppercase;color:var(--ac);margin:0}
    .h1{font:700 34px/1.06 var(--f);letter-spacing:-.035em;margin:0}
    .h2{font:700 21px/1.16 var(--f);letter-spacing:-.028em;margin:0}
    .h3{font:600 15px/1.3 var(--f);letter-spacing:-.01em;margin:0}
    .p{font:400 16px/1.5 var(--f);color:var(--l2);margin:0}
    .s{font:400 13px/1.45 var(--f);color:var(--l3);margin:0}
    .num{font-variant-numeric:tabular-nums}
    .card{border:1px solid var(--hair2);padding:22px}
    /* primario blanco, azul al hover — igual que .buy de la landing */
    .btn{height:44px;display:inline-flex;align-items:center;justify-content:center;gap:10px;padding:0 20px;border:0;border-radius:6px;background:var(--btn-bg);color:var(--btn-fg);font:600 11px/1 var(--m);letter-spacing:.1em;text-transform:uppercase;cursor:pointer;transition:background .2s,color .2s;font-family:var(--m)}
    .btn:hover{background:var(--ac);color:#fff}
    .btn:disabled{opacity:.45;cursor:default}
    .btn.ghost{background:transparent;border:1px solid var(--hair);color:var(--l1)}
    .btn.ghost:hover{background:var(--fill);color:var(--l1)}
    .btn.danger{background:transparent;border:1px solid var(--rd);color:var(--rd)}
    .chip{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:0 14px;border:1px solid var(--hair);background:transparent;color:var(--l1);font:500 14px/1.2 var(--m);cursor:pointer;transition:background .15s,border-color .15s}
    .chip:hover{background:var(--fill)}
    .chip[data-on]{border-color:var(--ac);background:rgba(10,132,255,.18)}
    .chip[data-ok]{border-color:var(--ok);background:rgba(48,209,88,.16)}
    .chip[data-bad]{border-color:var(--rd);background:rgba(255,69,58,.14)}
    .input{height:44px;width:100%;padding:0 14px;background:var(--fill);border:1px solid var(--hair2);color:var(--l1);font:400 15px/1 var(--f)}
    .input:focus{outline:none;border-color:var(--ac)}
    .input::placeholder{color:var(--l3);opacity:1}
    .bar{height:4px;background:rgba(120,120,128,.20)}
    .barfill{height:4px;background:var(--l1)}
    .nav{height:44px;display:flex;align-items:center;gap:11px;padding:0 16px;color:var(--l3);font:500 11px/1 var(--m);letter-spacing:.14em;text-transform:uppercase;border-left:2px solid transparent}
    .nav:hover{color:var(--l1);background:var(--fill)}
    .nav[aria-current]{color:var(--l1);background:var(--fill);border-left-color:var(--ac)}
    .seg{display:flex;border:1px solid var(--hair2)}
    .segb{height:30px;padding:0 10px;background:transparent;border:0;border-right:1px solid var(--hair2);color:var(--l3);font:600 10px/1 var(--m);letter-spacing:.12em;text-transform:uppercase;cursor:pointer;transition:background .15s,color .15s}
    .segb:last-child{border-right:0}
    .segb:hover{color:var(--l1);background:var(--fill)}
    .segb[aria-pressed="true"]{background:var(--ac-solid);color:#fff}
    .tblhead{font:500 10px/1 var(--m);letter-spacing:.16em;text-transform:uppercase;color:var(--l3)}
    #toasts{position:fixed;right:24px;bottom:24px;display:flex;flex-direction:column;gap:10px;width:372px;z-index:99}
    .toast{display:flex;align-items:flex-start;gap:12px;padding:14px 16px;border:1px solid var(--hair);background:var(--panel);animation:tin .18s ease-out}
    @keyframes tin{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
    input[type=range]{-webkit-appearance:none;appearance:none;background:transparent;height:30px;width:100%}
    input[type=range]::-webkit-slider-runnable-track{height:1px;background:rgba(235,235,245,.34)}
    input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:14px;height:26px;margin-top:-13px;border-radius:0;background:var(--l1);cursor:ew-resize}
  </style>
</head>
<body>
  <div style="display:flex;min-height:100vh">
    <aside style="width:248px;flex:none;border-right:1px solid var(--hair2);display:flex;flex-direction:column;position:sticky;top:0;height:100vh;background:var(--bg)">
      <a href="/panel" style="height:64px;display:flex;align-items:center;gap:11px;padding:0 18px;border-bottom:1px solid var(--hair2);color:var(--l1)">
        <span style="width:26px;height:26px;border:1px solid var(--hair);display:grid;place-items:center;font:700 12px/1 var(--f)">IA</span>
        <span style="font:600 13px/1.2 var(--f)">IA desde cero</span>
      </a>
      <nav style="display:flex;flex-direction:column;padding:12px 0;gap:2px">
        {NAV.map((n) => (
          <a href={n.href} class="nav" aria-current={n.label === active ? 'page' : undefined}>
            <Fragment set:html={icon(n.ic, 18)} />
            <span>{n.label}</span>
          </a>
        ))}
      </nav>
      <div style="margin-top:auto;border-top:1px solid var(--hair2);padding:14px 16px;display:flex;flex-direction:column;gap:12px">
        <div style="display:flex;align-items:center;gap:11px">
          <div style="width:34px;height:34px;flex:none;border:1px solid var(--hair);display:grid;place-items:center;font:600 12px/1 var(--m)">{initials(user.name)}</div>
          <div style="display:flex;flex-direction:column;gap:4px;min-width:0">
            <div style="font:600 13px/1 var(--f);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{user.name}</div>
            <div class="lbl" style="color:var(--ac)">{ROL[user.role] ?? user.role}</div>
          </div>
        </div>
        <button id="logout" class="nav" style="border-left:0;padding:0;height:32px;background:none;border:0;cursor:pointer;text-align:left">
          <Fragment set:html={icon('logout', 16)} />
          <span>{L.salir}</span>
        </button>
      </div>
    </aside>

    <main style="flex:1;min-width:0;display:flex;flex-direction:column">
      <header style="height:64px;flex:none;border-bottom:1px solid var(--hair2);display:flex;align-items:center;justify-content:space-between;gap:20px;padding:0 28px;position:sticky;top:0;background:var(--bg);z-index:5">
        <div class="lbl">{crumb}</div>
        <div style="display:flex;align-items:center;gap:18px">

          <div class="seg" role="group" aria-label={L.idioma}>
            <button class="segb" data-pref="lang" data-val="auto" aria-pressed={user.lang === 'auto'}>{L.automatico}</button>
            {IDIOMAS.map((c) => (
              <button class="segb" data-pref="lang" data-val={c} aria-pressed={user.lang === c}>{NOMBRE_IDIOMA[c] ?? c.toUpperCase()}</button>
            ))}
          </div>

          <div class="seg" role="group" aria-label={L.tema}>
            <button class="segb" data-pref="theme" data-val="auto" aria-pressed={user.theme === 'auto'} title={L.siguiendoEquipo}>{L.automatico}</button>
            <button class="segb" data-pref="theme" data-val="dark" aria-pressed={user.theme === 'dark'}>{L.oscuro}</button>
            <button class="segb" data-pref="theme" data-val="paper" aria-pressed={user.theme === 'paper'}>{L.papel}</button>
          </div>

          <div style="display:flex;align-items:center;gap:12px"><slot name="topbar" /></div>
        </div>
      </header>
      <slot />
    </main>
  </div>

  <div id="toasts"></div>
  <script type="application/json" id="txt" is:inline set:html={JSON.stringify({ ...L.avisos, auto: L.automatico, dark: L.oscuro, paper: L.papel })}></script>

  <script>
    import { animarIdioma } from '../lib/lang-anim';

    // Avisos: una sola API global, `toast(kind, title, body)`.
    const ICONS: Record<string, string> = {
      ok: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.6l4.4 4.4L19 7.2"/></svg>',
      bad: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4.4 2.8 19.6h18.4zM12 9.6v4.2M12 16.4v.1"/></svg>',
      warn: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4.4 2.8 19.6h18.4zM12 9.6v4.2M12 16.4v.1"/></svg>',
      info: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20.2a8.2 8.2 0 1 0 0-16.4 8.2 8.2 0 0 0 0 16.4zM12 11v5.4M12 8.1v.1"/></svg>',
    };
    const COLOR: Record<string, string> = { ok: 'var(--ok)', bad: 'var(--rd)', warn: 'var(--or)', info: 'var(--ac)' };
    const seen = new Map<string, HTMLElement>();
    const box = document.getElementById('toasts')!;
    const T = JSON.parse(document.getElementById('txt')!.textContent!) as Record<string, string>;
    // El aviso se arma con innerHTML por el icono, que es SVG de la casa. El titulo
    // y el cuerpo no lo son: varios llamantes pasan el `msg` que vino del servidor,
    // y un `msg` puede acabar llevando algo que escribio el cliente (por ejemplo el
    // content-type que mando). Escapar aqui, en la primitiva, protege a todos los
    // llamantes de una vez en lugar de confiar en que cada uno se acuerde.
    const esc = (v: string) => String(v).replace(/[&<>"]/g, (c) => (
      { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));
    (window as any).toast = (kind: string, title: string, body: string, key?: string) => {
      const id = key || title;
      if (seen.has(id)) { seen.get(id)!.remove(); seen.delete(id); }
      const el = document.createElement('div');
      el.className = 'toast';
      el.style.borderColor = COLOR[kind];
      el.innerHTML = `<div style="color:${COLOR[kind]};margin-top:1px">${ICONS[kind]}</div>
        <div style="display:flex;flex-direction:column;gap:4px;flex:1;min-width:0">
          <div class="h3">${esc(title)}</div><p class="s" style="color:var(--l2)">${esc(body)}</p></div>
        <button aria-label="Cerrar" style="background:none;border:0;color:var(--l3);cursor:pointer;padding:0">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M6.2 6.2l11.6 11.6M17.8 6.2 6.2 17.8"/></svg></button>`;
      el.querySelector('button')!.onclick = () => { el.remove(); seen.delete(id); };
      box.append(el);
      seen.set(id, el);
      while (box.children.length > 3) box.firstElementChild!.remove();
      if (kind === 'ok' || kind === 'info') setTimeout(() => { el.remove(); seen.delete(id); }, 4000);
    };
    // Toggles de idioma y tema. El tema se aplica al instante sobre <html data-theme>;
    // el idioma necesita recarga porque las cadenas se resuelven en el servidor.
    document.querySelectorAll<HTMLElement>('.segb[data-pref]').forEach((b) => b.addEventListener('click', async () => {
      const pref = b.dataset.pref!, val = b.dataset.val!;
      if (b.getAttribute('aria-pressed') === 'true') return;
      const group = b.parentElement!;
      const prev = group.querySelector<HTMLElement>('[aria-pressed="true"]');
      group.querySelectorAll('.segb').forEach((x) => x.setAttribute('aria-pressed', 'false'));
      b.setAttribute('aria-pressed', 'true');
      if (pref === 'theme') document.documentElement.setAttribute('data-theme', val);

      const res = await fetch('/api/settings', {
        method: 'PATCH', headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ [pref]: val }),
      });
      if (!res.ok) {
        group.querySelectorAll('.segb').forEach((x) => x.setAttribute('aria-pressed', 'false'));
        prev?.setAttribute('aria-pressed', 'true');
        if (pref === 'theme') document.documentElement.setAttribute('data-theme', prev?.dataset.val ?? 'auto');
        (window as any).toast('bad', T.noGuardo, T.noGuardoB, 'pref');
        return;
      }
      if (pref === 'lang') { await animarIdioma(b, val); location.reload(); return; }
      const auto = val === 'auto' ? T.temaSig : '';
      (window as any).toast('ok', T.temaOk, `${T[val] ?? val}${auto}.`, 'pref');
    }));

    document.getElementById('logout')!.onclick = async () => {
      await fetch('/api/auth/logout', { method: 'POST' });
      (window as any).toast('info', T.salio, T.salioB);
      setTimeout(() => location.assign('/login'), 500);
    };
  </script>
</body>
</html>
