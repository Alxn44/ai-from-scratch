---
export const prerender = false;
import App from '../layouts/App.astro';
import { gate, apiFetch, initials } from '../lib/session';
import { icon } from '../lib/icons';
import { t, resolveLang } from '../lib/i18n';
const { user, redirect } = await gate(Astro.request);
if (redirect) return Astro.redirect(redirect);
const prog = await apiFetch<{ solvedLabs: number; totalLabs: number; lessonsDone: number; totalLessons: number; perLesson: { n: number; total: number; solved: number }[] }>('/api/progress', Astro.request);
const L = t(resolveLang(user!.lang, Astro.request));
const pct = prog ? Math.round((prog.lessonsDone / prog.totalLessons) * 100) : 0;
const labPct = prog ? Math.round((prog.solvedLabs / prog.totalLabs) * 100) : 0;
---
<App user={user!} title="Perfil" crumb="PERFIL" active="Perfil">
  <a slot="topbar" class="btn ghost" style="height:36px;font-size:10px;text-decoration:none" href="/ajustes">{L.nav.ajustes}</a>
  <div style="padding:30px 28px 48px;display:flex;flex-direction:column;gap:26px;max-width:1180px">

    <div style="display:flex;align-items:flex-start;gap:24px;border-bottom:1px solid var(--hair);padding-bottom:26px">
      <!-- Las iniciales debajo y la foto encima. Si no hay foto, la peticion da 404,
           salta `error` y el cuadro se queda con las iniciales: ni parpadeo ni hueco. -->
      <div style="position:relative;width:92px;height:92px;flex:none">
        <div style="position:absolute;inset:0;border:1px solid var(--hair);display:grid;place-items:center;font:600 28px/1 var(--m)">{initials(user!.name)}</div>
        <!-- alt vacio a proposito: el nombre esta escrito al lado y un lector de
             pantalla no gana nada leyendolo dos veces. -->
        <img id="av-img" alt="" hidden
             style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;border:1px solid var(--hair)" />
      </div>
      <div style="display:flex;flex-direction:column;gap:10px;flex:1">
        <p class="eb">{L.perfil.titulo} · {user!.role === 'student' ? L.nav.perfil : user!.role}</p>
        <h1 class="h1">{user!.name}</h1>
        <p class="s" style="color:var(--l2)">{user!.email}{user!.cohort ? ` · cohorte de ${user!.cohort}` : ''} · {user!.paid ? L.perfil.comprado : L.perfil.sinCompra}</p>
        <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-top:2px">
          <input type="file" id="av-file" accept="image/png,image/jpeg,image/webp,image/avif,image/gif" hidden />
          <button class="btn ghost" id="av-cambiar" style="height:32px;font-size:10px"><Fragment set:html={icon('user', 14)} /><span>{L.perfil.cambiarFoto}</span></button>
          <button class="btn ghost" id="av-quitar" hidden style="height:32px;font-size:10px"><Fragment set:html={icon('x', 14)} /><span>{L.perfil.quitarFoto}</span></button>
          <span class="s" style="color:var(--l2)">{L.perfil.fotoNota}</span>
        </div>
      </div>
    </div>

    <div style="display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:22px">
      <div class="card" style="display:flex;flex-direction:column;gap:10px"><p class="lbl">{L.perfil.leccionesCap}</p><div class="num" style="font:700 34px/1 var(--f);letter-spacing:-.04em">{prog?.lessonsDone} / {prog?.totalLessons}</div><div class="bar"><div class="barfill" style={`width:${pct}%`}></div></div></div>
      <div class="card" style="display:flex;flex-direction:column;gap:10px"><p class="lbl">{L.perfil.labsCap}</p><div class="num" style="font:700 34px/1 var(--f);letter-spacing:-.04em">{prog?.solvedLabs} / {prog?.totalLabs}</div><div class="bar"><div class="barfill" style={`width:${labPct}%`}></div></div></div>
      <div class="card" style="display:flex;flex-direction:column;gap:10px"><p class="lbl">{L.perfil.idiomaCap}</p><div style="font:700 20px/1.2 var(--f)">{resolveLang(user!.lang, Astro.request) === 'es' ? 'Español' : 'English'}{user!.lang === 'auto' ? ' · auto' : ''}</div><p class="s">{L.perfil.cambiaAqui}</p></div>
      <div class="card" style="display:flex;flex-direction:column;gap:10px"><p class="lbl">{L.perfil.certificado}</p><div class="num" style="font:700 20px/1.2 var(--f);color:var(--l3)">{L.perfil.alCien}</div><p class="s">{L.perfil.seEmite}</p></div>
    </div>

    <div style="display:grid;grid-template-columns:1.5fr 1fr;gap:24px;align-items:start">
      <div style="display:flex;flex-direction:column;gap:14px">
        <p class="lbl">{L.perfil.avance}</p>
        <div style="display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:12px">
          {prog?.perLesson.map((l) => {
            const done = l.solved === l.total, some = l.solved > 0;
            const col = done ? 'var(--ok)' : some ? 'var(--ac)' : 'var(--hair)';
            // --hair es color de borde: como texto da 1.4:1. El número usa --l3 (4.6:1 medido).
            const txtCol = done || some ? col : 'var(--l3)';
            const bg = done ? 'rgba(48,209,88,.14)' : some ? 'rgba(10,132,255,.14)' : 'transparent';
            return (
              <a href={`/leccion/${l.n}`} style={`border:1px solid ${col};background:${bg};padding:12px;display:flex;flex-direction:column;gap:7px;color:var(--l1)`}>
                <span class="num" style={`font:600 13px/1 var(--m);color:${txtCol}`}>{String(l.n).padStart(2, '0')}</span>
                <span class="num s">{l.solved}/{l.total} {L.perfil.labsAbrev}</span>
              </a>
            );
          })}
        </div>
      </div>
      <div class="card" style="display:flex;flex-direction:column;gap:12px">
        <p class="lbl">{L.perfil.tuMaterial}</p>
        <button class="btn ghost" id="pdf-es" style="justify-content:flex-start"><Fragment set:html={icon('pdf', 16)} /><span>{L.perfil.cursoEs}</span></button>
        <button class="btn ghost" id="pdf-en" style="justify-content:flex-start"><Fragment set:html={icon('pdf', 16)} /><span>{L.perfil.cursoEn}</span></button>
      </div>
    </div>
  </div>

  <script type="application/json" id="ui-txt" is:inline set:html={JSON.stringify(L.ui)}></script>

  <script>
    const U = JSON.parse(document.getElementById('ui-txt')!.textContent!);

    // ---- la foto ----
    // Los mismos limites que declara `api/src/medios.js` para el cubo `avatares`.
    // Repetirlos aqui no sustituye al servidor: sirve para contestar al instante en
    // vez de subir 5 MB para que los rechacen.
    const MAX_FOTO = 2 * 1024 * 1024;
    const TIPOS_FOTO = ['image/png', 'image/jpeg', 'image/webp', 'image/avif', 'image/gif'];

    const img = document.getElementById('av-img') as HTMLImageElement;
    const quitar = document.getElementById('av-quitar') as HTMLButtonElement;
    const cambiar = document.getElementById('av-cambiar') as HTMLButtonElement;
    const fichero = document.getElementById('av-file') as HTMLInputElement;

    // Cada codigo de medios, a su aviso. Los cuatro de infraestructura dicen lo
    // mismo: al que mira la pantalla no le sirve saber cual de los cuatro fue.
    const AVISOS: Record<string, [string, string]> = {
      demasiado_grande: [U.avGrande, U.avGrandeB],
      tipo_no_permitido: [U.avTipo, U.avTipoB],
      medios_caido: [U.avSinAlmacen, U.avSinAlmacenB],
      medios_sin_configurar: [U.avSinAlmacen, U.avSinAlmacenB],
      medios_sin_preparar: [U.avSinAlmacen, U.avSinAlmacenB],
      medios_mal_configurado: [U.avSinAlmacen, U.avSinAlmacenB],
    };

    const verFoto = (hay: boolean) => { img.hidden = !hay; quitar.hidden = !hay; };
    img.addEventListener('load', () => verFoto(true));
    img.addEventListener('error', () => verFoto(false));
    // El cubo va sin cache, asi que no hace falta romperla al cargar; al
    // reemplazar si, porque la URL es la misma y el navegador ya tiene una imagen
    // pintada en pantalla.
    img.src = '/api/medios/avatar';

    cambiar.addEventListener('click', () => fichero.click());

    fichero.addEventListener('change', async () => {
      const f = fichero.files?.[0];
      fichero.value = '';                       // permite reintentar con el mismo fichero
      if (!f) return;
      if (!TIPOS_FOTO.includes(f.type)) return window.toast('warn', U.avTipo, U.avTipoB);
      if (f.size > MAX_FOTO) return window.toast('warn', U.avGrande, U.avGrandeB);

      cambiar.disabled = true;
      try {
        // El cuerpo son los bytes en crudo, no un formulario: Astro los reenvia
        // como stream y el API los pasa al almacen sin juntarlos en memoria.
        const res = await fetch('/api/medios/avatar', {
          method: 'PUT', headers: { 'content-type': f.type }, body: f,
        });
        if (res.ok) {
          img.src = `/api/medios/avatar?v=${Date.now()}`;
          window.toast('ok', U.avPuesta, U.avPuestaB);
        } else {
          const d = await res.json().catch(() => ({}));
          const [t, b] = AVISOS[d.error] ?? [U.avFallo, d.msg ?? U.avFalloB];
          window.toast(res.status >= 500 ? 'bad' : 'warn', t, b);
        }
      } catch {
        window.toast('bad', U.avFallo, U.avFalloB);
      } finally {
        cambiar.disabled = false;
      }
    });

    quitar.addEventListener('click', async () => {
      quitar.disabled = true;
      try {
        const res = await fetch('/api/medios/avatar', { method: 'DELETE' });
        // El borrado es idempotente: un 204 y un 404 significan lo mismo aqui.
        if (res.ok || res.status === 404) { img.removeAttribute('src'); verFoto(false); window.toast('ok', U.avQuitada, U.avQuitadaB); }
        else window.toast('bad', U.avFallo, U.avFalloB);
      } catch {
        window.toast('bad', U.avFallo, U.avFalloB);
      } finally {
        quitar.disabled = false;
      }
    });

    // ---- los PDF ----
    for (const lang of ['es', 'en']) {
      document.getElementById(`pdf-${lang}`)!.addEventListener('click', async () => {
        const res = await fetch(`/api/pdf/${lang}`);
        if (res.ok) {
          const a = document.createElement('a');
          a.href = URL.createObjectURL(await res.blob());
          a.download = `ia-desde-cero-${lang}.pdf`; a.click();
          window.toast('info', U.pdfListo, U.pdfListoB);
        } else {
          const d = await res.json().catch(() => ({}));
          window.toast(res.status === 402 ? 'warn' : 'bad', res.status === 402 ? U.pdfSinCompra : U.pdfNoGenerado, d.msg ?? (res.status === 402 ? U.pdfSinCompraB : U.pdfNoGeneradoB));
        }
      });
    }
  </script>
</App>
