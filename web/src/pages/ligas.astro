---
export const prerender = false;
import App from '../layouts/App.astro';
import { gate, apiFetch } from '../lib/session';
import { t, resolveLang } from '../lib/i18n';
import { medalla, type MetalLiga } from '../lib/insignias';

const { user, redirect } = await gate(Astro.request);
if (redirect) return Astro.redirect(redirect);

const lang = resolveLang(user!.lang, Astro.request);
const L = t(lang);
const G = L.ligas;

type Fila = { alias: string; caudal: number; total: number; metal: MetalLiga; estado: string; puesto: number };
type Resp = {
  activa: boolean; faltan?: number; minimo: number; zona: string;
  semana: { lunes: string; cierra: string };
  tabla: Fila[];
  yo: { alias: string; metal: MetalLiga; puesto: number; caudal: number; estado: string } | null;
};
const d = await apiFetch<Resp>('/api/ligas', Astro.request);

const METALES: MetalLiga[] = ['oro', 'plata', 'bronce'];   // arriba el que más pesa
const porMetal = (m: MetalLiga) => (d?.tabla ?? []).filter((r) => r.metal === m);
const fecha = (iso?: string) =>
  iso ? new Intl.DateTimeFormat(lang === 'en' ? 'en-US' : 'es-CO',
    { day: 'numeric', month: 'long', timeZone: 'America/Bogota' }).format(new Date(iso)) : '';
---
<App user={user!} title={G.titulo} crumb={G.crumb} active={L.nav.ligas}>
  <a slot="topbar" class="btn ghost" style="height:36px;font-size:10px;text-decoration:none" href="/ranking">{L.rank.titulo}</a>

  <div style="padding:30px 28px 48px;display:flex;flex-direction:column;gap:26px;max-width:1180px">

    <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:24px;flex-wrap:wrap">
      <div style="display:flex;flex-direction:column;gap:12px">
        <p class="eb">{G.eb}</p>
        <h1 class="h1">{G.titulo}</h1>
        <p class="p" style="max-width:640px">{G.pitch}</p>
      </div>

      {d?.yo
        ? <div class="card" style="width:330px;border-left:2px solid var(--ac);display:flex;gap:16px;align-items:center">
            <div style="flex:none"><Fragment set:html={medalla(d.yo.metal, 'yo-medalla', 74)} /></div>
            <div style="display:flex;flex-direction:column;gap:5px;min-width:0">
              <p class="lbl">{G.tuLiga}</p>
              <div class="h1" style="font-size:24px">{G[d.yo.metal]}</div>
              <p class="s" style="color:var(--l2)">
                {G.puesto} <b style="color:var(--l1);font-weight:600">{d.yo.puesto}</b> · {G.caudal} <b style="color:var(--l1);font-weight:600">{d.yo.caudal}</b>
              </p>
              {d.yo.estado === 'salon' && <span class="num" style="align-self:flex-start;border:1px solid var(--ok);color:var(--ok);font:600 9px/1 var(--m);letter-spacing:.12em;text-transform:uppercase;padding:5px 7px">{G.salon}</span>}
            </div>
          </div>
        : <div class="card" style="width:330px;border-left:2px solid var(--or);display:flex;flex-direction:column;gap:7px">
            <p class="lbl">{G.sinLiga}</p>
            <div class="h3" style="color:var(--or)">{G.fuera}</div>
            <p class="s" style="color:var(--l2)">{G.fueraB}</p>
            <a class="btn ghost" href="/ranking" style="margin-top:6px;height:34px;font-size:10px;text-decoration:none">{L.rank.apuntarme}</a>
          </div>}
    </div>

    <div style="display:flex;align-items:baseline;gap:14px;border-bottom:1px solid var(--hair);padding-bottom:14px;flex-wrap:wrap">
      <p class="lbl">{G.cierra.replace('{d}', fecha(d?.semana?.cierra))}</p>
      <span class="s" style="color:var(--l3)">{G.zona.replace('{z}', d?.zona ?? 'America/Bogota')}</span>
    </div>

    {!d?.activa
      ? <div class="card" style="border-style:dashed;display:flex;flex-direction:column;gap:8px">
          <div class="h3">{G.pocos}</div>
          <p class="p" style="font-size:15px;max-width:620px">{G.pocosB.replace('{n}', String(d?.faltan ?? d?.minimo ?? 5))}</p>
        </div>
      : <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:16px;align-items:start">
          {METALES.map((m) => (
            <div class="card" style="display:flex;flex-direction:column;gap:14px">
              <div style="display:flex;align-items:center;gap:12px">
                <Fragment set:html={medalla(m, `cab-${m}`, 44)} />
                <div style="display:flex;flex-direction:column;gap:3px">
                  <div class="h3">{G[m]}</div>
                  <span class="s num" style="color:var(--l3)">{porMetal(m).length}</span>
                </div>
              </div>
              {porMetal(m).length === 0
                ? <p class="s" style="color:var(--l3)">{G.nadie}</p>
                : <div style="display:flex;flex-direction:column">
                    {porMetal(m).map((r) => (
                      <div style={`display:flex;align-items:center;gap:11px;padding:9px 0;border-top:1px solid var(--hair2);${r.alias === d.yo?.alias ? 'background:var(--fill)' : ''}`}>
                        <span class="num" style="width:26px;color:var(--l3);font:500 12px/1 var(--m)">{r.puesto}</span>
                        <span style="font:600 13px/1 var(--f);color:var(--l1);overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{r.alias}</span>
                        {r.alias === d.yo?.alias && <span class="s" style="color:var(--ac)">· {G.tu}</span>}
                        {r.estado === 'salon' && <span class="num" style="border:1px solid var(--ok);color:var(--ok);font:600 8px/1 var(--m);letter-spacing:.1em;text-transform:uppercase;padding:3px 5px">{G.salon}</span>}
                        <span class="num" style="margin-left:auto;font:600 14px/1 var(--m);color:var(--l1)">{r.caudal}</span>
                      </div>
                    ))}
                  </div>}
            </div>
          ))}
        </div>}

    <div class="card" style="border-color:var(--hair2);display:flex;flex-direction:column;gap:8px;max-width:760px">
      <p class="lbl">{G.comoLbl}</p>
      <p class="s" style="color:var(--l2)">{G.comoB}</p>
      <p class="s" style="color:var(--l2)">{G.salonB}</p>
    </div>
  </div>
</App>
