# api/.env — reference, not a template to copy blindly.
#
# Generate the real file with `pnpm keys`. It writes api/.env, web/.env, ai/.env
# and the compose .env with real random values.
#
# WHY THE SECRETS ARE EMPTY HERE AND NOT FILLED WITH A PLACEHOLDER
# This file used to ship JWT_SECRET=cambia-esto-por-32-bytes-aleatorios. That is
# 35 characters, so it passed the length check and worked as a signing key — a
# signing key published in the repository. Anyone who copied this file to .env
# was running with a secret every reader of the repo knows, which means anyone
# could mint an admin session. The values are empty now so that copying this file
# FAILS instead of appearing to work: an empty JWT_SECRET is refused outright
# outside development, which is the correct outcome.
#
# Never put a working value in this file.

# ---------------------------------------------------------------------------
# Required. The server refuses to start without these.
# ---------------------------------------------------------------------------

# Signing key for session cookies. 32+ characters of randomness.
#   pnpm keys      (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))")
# In development only, leaving it empty mints an ephemeral key and warns; every
# restart then invalidates every session, which is a nuisance, not a security
# hole. Outside development, empty is a hard failure.
JWT_SECRET=

# Postgres. Only the migration/seed process uses this local value. The runtime
# API and api-worker must not receive it; Compose injects it only into `init` and
# `data`.
DATABASE_URL=postgres://curso:curso@localhost:5432/curso

# ---------------------------------------------------------------------------
# The AI service. Without IA_SECRETO the chat answers 501 rather than pretending.
# The Spanish names are the wire contract shared with ai/ — renaming them breaks
# both services at once.
# ---------------------------------------------------------------------------
IA_URL=http://127.0.0.1:8799
# Must be byte-identical to IA_SECRETO in ai/.env. If they differ, the service
# answers 401, the api turns that into 502, and from the browser it looks like a
# chat bug rather than a configuration mismatch.
IA_SECRETO=

# Identity of queue/. Accepted only on /api/v3/interno/bus/claim and deliberately
# different from IA_SECRETO so queue cannot call agent tools.
QUEUE_SECRETO=

# ---------------------------------------------------------------------------
# Where the browser is, for CORS and cookie scope.
# ---------------------------------------------------------------------------
WEB_ORIGIN=http://localhost:4321
PORT=8787
HOST=127.0.0.1
# The public origin, when it differs from WEB_ORIGIN (behind a tunnel or proxy).
# PUBLIC_ORIGIN=

# `production` turns off every development affordance, including the ephemeral
# JWT key and the demo accounts.
NODE_ENV=development

# ---------------------------------------------------------------------------
# RabbitMQ, for work that crosses services. Absent, the bus reports failure
# rather than claiming a publish that never happened; nothing else breaks.
# ---------------------------------------------------------------------------
# AMQP_URL=amqp://app:PASSWORD@127.0.0.1:5672/
# BUS_QUEUE=

# ---------------------------------------------------------------------------
# Model providers. All optional: with none of them the chat says `sin_proveedor`
# instead of failing obscurely. PROVEEDOR_ORDEN sets the fallback chain.
# ---------------------------------------------------------------------------
# Flash primero (Haiku). Sonnet y Grok razonan. Opus no se usa.
# PROVEEDOR_ORDEN=anthropic,deepseek,kimi,grok,sonnet
# OMNIROUTE_API_KEY=
# OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1/chat/completions
# OMNIROUTE_MODEL=openrouter/auto
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
# OPENROUTER_MODEL=openrouter/auto
# XAI_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1/chat/completions
# XAI_MODEL=grok-4.6
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=
# KIMI_API_KEY=
# MOONSHOT_API_KEY=
# KIMI_MODEL=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5
# ANTHROPIC_SONNET_MODEL=claude-sonnet-5
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# OPENCODE_API_KEY=
# OPENCODE_BASE_URL=
# OPENCODE_MODEL=
# HUGGINGFACE_API_KEY=
# HF_TOKEN=
# HF_MODEL=

# ---------------------------------------------------------------------------
# Payments service. Mercado Pago credentials live in payments/.env, never here.
# ---------------------------------------------------------------------------
PAYMENTS_URL=http://127.0.0.1:8785
PAYMENTS_SECRET=

# ---------------------------------------------------------------------------
# AI message store. Own Postgres, JSONB documents. Never the course database.
# ---------------------------------------------------------------------------
MESSAGES_URL=http://127.0.0.1:8786
MESSAGES_SECRET=

# ---------------------------------------------------------------------------
# Limits and tuning. The defaults are in the code; these only override them.
# ---------------------------------------------------------------------------
# CHAT_POR_MINUTO=
# CHAT_TOPE_DIA=
# CHAT_TOPE_DIA_GLOBAL=
# scrypt at N=2^17 needs ~128 MiB per call, so concurrency is capped rather than
# letting parallel logins exhaust memory.
# KDF_MAX_CONCURRENT=2
# LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Demo accounts. Off by default, and refused entirely under NODE_ENV=production.
# This used to plant an admin whose password was committed to the repository, on
# every single start.
# ---------------------------------------------------------------------------
# SEED_DEMO_USERS=1
# SEED_DEMO_PASSWORD=

# ---------------------------------------------------------------------------
# root/root. A two-keystroke admin for a laptop, nothing else. Off by default,
# refused under NODE_ENV=production AND refused against any database host that
# is not localhost/127.0.0.1/::1 — a four-letter password cannot be trusted to
# an environment variable someone forgot to set.
# ---------------------------------------------------------------------------
# SEED_ROOT_USER=1
