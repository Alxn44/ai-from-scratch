{
  "name": "ia-desde-cero-api",
  "type": "module",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "node --experimental-strip-types --env-file-if-exists=.env --watch src/server.ts",
    "build": "tsgo -p .",
    "start": "node --env-file-if-exists=.env dist/api/src/server.js",
    "seed": "node --experimental-strip-types --env-file-if-exists=.env src/seed.ts",
    "worker": "node --experimental-strip-types --env-file-if-exists=.env src/worker.ts",
    "test": "sh ../scripts/test-api-with-data.sh test:direct",
    "test:direct": "node --experimental-strip-types --env-file-if-exists=.env test/questions.mts && node --experimental-strip-types --env-file-if-exists=.env test/questions-http.mts && node --experimental-strip-types --env-file-if-exists=.env test/isolation.mts && node --experimental-strip-types --env-file-if-exists=.env test/agent-bus.mts && node --experimental-strip-types --env-file-if-exists=.env test/transport.mts && node --experimental-strip-types --env-file-if-exists=.env test/tools.mts && node --experimental-strip-types --env-file-if-exists=.env test/queue.mts && node --experimental-strip-types --env-file-if-exists=.env test/auth-boundary.mts && node --experimental-strip-types --env-file-if-exists=.env test/bridge.mts && node --experimental-strip-types --env-file-if-exists=.env test/coach.mts && node --experimental-strip-types --env-file-if-exists=.env test/data.mts && node --experimental-strip-types --env-file-if-exists=.env test/role-escalation.mts",
    "test:questions": "node --experimental-strip-types --env-file-if-exists=.env test/questions.mts",
    "test:questions-http": "node --experimental-strip-types --env-file-if-exists=.env test/questions-http.mts",
    "test:isolation": "sh ../scripts/test-api-with-data.sh test:isolation:direct",
    "test:isolation:direct": "node --experimental-strip-types --env-file-if-exists=.env test/isolation.mts",
    "test:agent-bus": "node --experimental-strip-types --env-file-if-exists=.env test/agent-bus.mts",
    "test:transport": "node --experimental-strip-types --env-file-if-exists=.env test/transport.mts",
    "test:tools": "sh ../scripts/test-api-with-data.sh test:tools:direct",
    "test:tools:direct": "node --experimental-strip-types --env-file-if-exists=.env test/tools.mts",
    "test:queue": "node --experimental-strip-types --env-file-if-exists=.env test/queue.mts",
    "test:bridge": "node --experimental-strip-types --env-file-if-exists=.env test/bridge.mts",
    "test:coach": "node --experimental-strip-types --env-file-if-exists=.env test/coach.mts",
    "test:data": "node --experimental-strip-types --env-file-if-exists=.env test/data.mts",
    "test:roles": "node --experimental-strip-types --env-file-if-exists=.env test/role-escalation.mts",
    "leagues:close": "node --experimental-strip-types --env-file-if-exists=.env scripts/close-leagues.mjs",
    "check": "node scripts/types.mjs",
    "check:list": "node scripts/types.mjs --list",
    "check:pin": "node scripts/types.mjs --pin",
    "subs:expire": "node --experimental-strip-types scripts/expire-subscriptions.mjs",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:migrate": "prisma migrate dev",
    "db:pull": "prisma db pull",
    "db:drift": "prisma migrate diff --from-migrations prisma/migrations --to-config-datasource --script --exit-code"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "amqplib": "^2.0.1",
    "fastify": "^5.12.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "dotenv": "^17.4.2",
    "prisma": "^7.9.1",
    "typescript": "^7.0.2"
  }
}
