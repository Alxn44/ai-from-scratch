---
// Shell de las páginas sin sesión (legales, soporte, resultado de pago, 404).
// Trae los toggles de idioma/tema y el pie con los enlaces legales, así ninguna
// página pública vuelve a copiar la cabecera.
import { t } from '../lib/i18n';
import { publicPrefs } from '../lib/prefs';
import { TOKENS, PUBLIC_BASE } from '../lib/theme-css';
import PrefToggles from '../components/PrefToggles.astro';
import { SITE, MARCA } from '../lib/site';

interface Props { title: string; noindex?: boolean; desc?: string; ancho?: number; jsonld?: string; }
const { title, noindex = false, desc, ancho = 900, jsonld } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE).href;

const { lang, langPref, theme } = publicPrefs(Astro.request);
const L = t(lang);
const F = L.pub.footer;
---
<!doctype html>
<html lang={lang} data-theme={theme}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any">
  <title>{title} · IA desde cero</title>
  {desc && <meta name="description" content={desc} />}
  {noindex
    ? <meta name="robots" content="noindex" />
    : <link rel="canonical" href={canonical} />}
  <meta property="og:site_name" content={MARCA} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={`${title} · ${MARCA}`} />
  {desc && <meta property="og:description" content={desc} />}
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content={lang === 'es' ? 'es_CO' : 'en_US'} />
  <meta name="twitter:card" content="summary_large_image" />
  {jsonld && <script type="application/ld+json" is:inline set:html={jsonld}></script>}
  <style is:global set:html={TOKENS + PUBLIC_BASE}></style>
  <style is:global>
    .wrap{margin:0 auto;padding:0 32px}
    .sec{border-top:1px solid var(--hair2);padding:22px 0;display:grid;grid-template-columns:230px 1fr;gap:28px;align-items:start}
    @media (max-width:760px){.sec{grid-template-columns:1fr;gap:8px}}
    .lk{color:var(--l2);font:400 13px/1.45 var(--f)}
    .lk:hover{color:var(--ac)}
  </style>
</head>
<body>
  <header style="border-bottom:1px solid var(--hair2);position:sticky;top:0;background:var(--bg);z-index:5">
    <div class="wrap pub-head" style={`max-width:${ancho}px`}>
      <a href="/" style="display:flex;align-items:center;gap:11px;color:var(--l1)">
        <span class="mark">IA</span>
        <span style="font:600 13px/1.2 var(--f)">IA desde cero</span>
        <span class="lbl" style="margin-left:6px">{L.pub.marca}</span>
      </a>
      <PrefToggles lang={langPref} theme={theme} labels={{ auto: L.pub.auto, dark: L.pub.oscuro, paper: L.pub.papel, langAria: L.pub.ariaIdioma, themeAria: L.pub.ariaTema }} />
    </div>
  </header>

  <main class="wrap" style={`max-width:${ancho}px;padding-top:46px;padding-bottom:64px`}>
    <slot />
  </main>

  <footer style="border-top:1px solid var(--hair2)">
    <div class="wrap" style={`max-width:${ancho}px;padding-top:22px;padding-bottom:34px;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:16px`}>
      <div style="display:flex;gap:18px;flex-wrap:wrap">
        <a class="lk" href="/">{F.inicio}</a>
        <a class="lk" href="/terminos">{F.term}</a>
        <a class="lk" href="/privacidad">{F.priv}</a>
        <a class="lk" href="/soporte">{F.sop}</a>
      </div>
      <p class="s">{F.der}</p>
    </div>
  </footer>

  <div id="toasts"></div>
  <script>
    import { montarAvisos } from '../lib/avisos';
    montarAvisos(document.documentElement.lang === 'en' ? 'Close' : 'Cerrar');
  </script>
</body>
</html>
