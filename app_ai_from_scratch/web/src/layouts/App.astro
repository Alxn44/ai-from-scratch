---
import { icon } from '../lib/icons';
import { initials, type User } from '../lib/session';
import { t, resolveLang, IDIOMAS, NOMBRE_IDIOMA, type Lang } from '../lib/i18n';
import { TOKENS, LANG_FX } from '../lib/theme-css';
import { jsonSafe } from '../lib/json-safe';
import { aiFlags } from '../lib/ai-mode';
import { sidebarCollapsed, sidebarRail } from '../lib/sidebar';
import AiPanel from '../components/AiPanel.astro';
interface Props { user: User; title: string; crumb: string; active: string; }
const { user, title, crumb, active } = Astro.props;

// Idioma efectivo: si la preferencia es 'auto' se resuelve en el servidor con
// Accept-Language (el idioma del equipo) — así no hay parpadeo de contenido.
const lang: Lang = resolveLang(user.lang, Astro.request);
const L = t(lang);
// El tema 'auto' lo resuelve el CSS con prefers-color-scheme, sin JS y sin parpadeo.
const themeAttr = user.theme;

// Data embedded in a <script type="application/json"> block must not contain a
// literal "<": a value holding "</script>" would close the element early and the
// browser would parse the rest as HTML. "\u003c" is the same character to any
// JSON parser and inert to the HTML parser.

const NAV = [
  { href: '/panel',     ic: 'home',   key: 'panel',   label: L.nav.panel,   roles: ['student', 'tutor', 'admin'] },
  { href: '/curso',     ic: 'book',   key: 'curso',   label: L.nav.curso,   roles: ['student', 'tutor', 'admin'] },
  { href: '/logros',    ic: 'chart',  key: 'logros',  label: L.nav.logros,  roles: ['student', 'tutor', 'admin'] },
  { href: '/ranking',   ic: 'chart',  key: 'ranking', label: L.nav.ranking, roles: ['student', 'tutor', 'admin'] },
  { href: '/ligas',     ic: 'chart',  key: 'ligas',   label: L.nav.ligas,   roles: ['student', 'tutor', 'admin'] },
  { href: '/tutor',     ic: 'users',  key: 'cohorte', label: L.nav.cohorte, roles: ['tutor', 'admin'] },
  { href: '/admin',     ic: 'shield', key: 'admin',   label: L.nav.admin,   roles: ['admin'] },
  { href: '/perfil',    ic: 'user',   key: 'perfil',  label: L.nav.perfil,  roles: ['student', 'tutor', 'admin'] },
  { href: '/ajustes',   ic: 'gear',   key: 'ajustes', label: L.nav.ajustes, roles: ['student', 'tutor', 'admin'] },
].filter((n) => n.roles.includes(user.role));

const ROL: Record<string, string> = { student: L.ui.rolStudent, tutor: L.ui.rolTutor, admin: L.ui.rolAdmin };

// AI mode replaces the «Chat» nav entry. A nav entry NAVIGATES: it took the
// student off the lesson they were reading to go and ask about it. The toggle
// switches on a layer that follows them instead, so the same question can be
// asked from any tab without losing the page. The state is read from the cookie
// HERE, on the server, so the switch never paints in the wrong position first
// (the same reason `lang` and `theme` live in cookies).
//
// /chat still exists and still works — the panel links to it. Removing the route
// would 404 every bookmark, and the full page is still the right place for a long
// answer with its tool trace.
const ia = aiFlags(Astro.request);
const railCollapsed = sidebarCollapsed(Astro.request);
// Las capas fijas de abajo (#toasts, #ia-capa, el gato) no saben unas de otras.
// Si la pagina pone barra de accion hay que levantarlas, y eso se decide aqui
// porque CSS no puede detectar un slot vacio a traves de la frontera del DOM.
const hasAction = Astro.slots.has('action');
const rail = sidebarRail(Astro.request);
// El slot de accion se pinta DOS veces: en la cabecera (escritorio) y en la barra
// inferior (movil). Solo una es visible en cada anchura y la otra va con
// display:none, asi que no se duplica en el arbol de accesibilidad.
// Se renderiza a texto UNA vez porque <slot name="x"/> repetido no es contrato
// estable, y porque el contenido es un enlace suelto sin id: duplicarlo es
// inocuo. NO metas aqui nada con id ni con data-tut.
const actionHtml = hasAction ? await Astro.slots.render('action') : '';
---
<!doctype html>
<html lang={lang} data-theme={themeAttr} data-action={hasAction ? "1" : undefined}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any">
  <title>{title} · IA desde cero</title>
  <style is:global set:html={TOKENS + LANG_FX}></style>
  <style is:global>
    *{box-sizing:border-box}
    body{margin:0;background:var(--bg);font-family:var(--f);color:var(--l1);-webkit-font-smoothing:antialiased;transition:background .2s,color .2s}
    a{color:var(--ac);text-decoration:none}
    a:hover{color:#409CFF}
    .lbl{font:500 10px/1 var(--m);letter-spacing:.18em;text-transform:uppercase;color:var(--l3);margin:0}
    .eb{font:600 10px/1 var(--m);letter-spacing:.22em;text-transform:uppercase;color:var(--ac);margin:0}
    .h1{font:700 34px/1.06 var(--f);letter-spacing:-.035em;margin:0}
    .h2{font:700 21px/1.16 var(--f);letter-spacing:-.028em;margin:0}
    .h3{font:600 15px/1.3 var(--f);letter-spacing:-.01em;margin:0}
    .p{font:400 16px/1.5 var(--f);color:var(--l2);margin:0}
    .s{font:400 13px/1.45 var(--f);color:var(--l3);margin:0}
    .num{font-variant-numeric:tabular-nums}
    .card{border:1px solid var(--hair2);padding:22px}
    /* primario blanco, azul al hover — igual que .buy de la landing */
    .btn{height:44px;display:inline-flex;align-items:center;justify-content:center;gap:10px;padding:0 20px;border:0;border-radius:6px;background:var(--btn-bg);color:var(--btn-fg);font:600 11px/1 var(--m);letter-spacing:.1em;text-transform:uppercase;cursor:pointer;transition:background .2s,color .2s;font-family:var(--m)}
    .btn:hover{background:var(--ac);color:#fff}
    .btn:disabled{opacity:.45;cursor:default}
    .btn.ghost{background:transparent;border:1px solid var(--hair);color:var(--l1)}
    .btn.ghost:hover{background:var(--fill);color:var(--l1)}
    .btn.danger{background:transparent;border:1px solid var(--rd);color:var(--rd)}
    .chip{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:0 14px;border:1px solid var(--hair);background:transparent;color:var(--l1);font:500 14px/1.2 var(--m);cursor:pointer;transition:background .15s,border-color .15s}
    .chip:hover{background:var(--fill)}
    .chip[data-on]{border-color:var(--ac);background:rgba(10,132,255,.18)}
    .chip[data-ok]{border-color:var(--ok);background:rgba(48,209,88,.16)}
    .chip[data-bad]{border-color:var(--rd);background:rgba(255,69,58,.14)}
    .input{height:44px;width:100%;padding:0 14px;background:var(--fill);border:1px solid var(--hair2);color:var(--l1);font:400 15px/1 var(--f)}
    .input:focus{outline:none;border-color:var(--ac)}
    .input::placeholder{color:var(--l3);opacity:1}
    .bar{height:4px;background:rgba(120,120,128,.20)}
    .barfill{height:4px;background:var(--l1)}
    .nav{height:44px;display:flex;align-items:center;gap:11px;padding:0 16px;color:var(--l3);font:500 11px/1 var(--m);letter-spacing:.14em;text-transform:uppercase;border-left:2px solid transparent}
    .nav:hover{color:var(--l1);background:var(--fill)}
    .nav[aria-current]{color:var(--l1);background:var(--fill);border-left-color:var(--ac)}
    .seg{display:flex;border:1px solid var(--hair2)}
    .segb{height:30px;padding:0 10px;background:transparent;border:0;border-right:1px solid var(--hair2);color:var(--l3);font:600 10px/1 var(--m);letter-spacing:.12em;text-transform:uppercase;cursor:pointer;transition:background .15s,color .15s}
    .segb:last-child{border-right:0}
    .segb:hover{color:var(--l1);background:var(--fill)}
    .segb[aria-pressed="true"]{background:var(--ac-solid);color:#fff}
    .tblhead{font:500 10px/1 var(--m);letter-spacing:.16em;text-transform:uppercase;color:var(--l3)}
    /* Carril compartido por los toasts y por los avisos de desbloqueo. El ancho es
       automatico porque la tarjeta de rango mide 436px; con width fijo a 372 se
       recortaba. Dos carriles fijos abajo-derecha se solapan, y el que perderia
       seria el aviso de error. */
    #toasts{position:fixed;right:24px;bottom:calc(24px + env(safe-area-inset-bottom));display:flex;flex-direction:column;align-items:flex-end;gap:10px;width:auto;max-width:calc(100vw - 48px);z-index:99}
    .toast{width:372px;box-sizing:border-box;display:flex;align-items:flex-start;gap:12px;padding:14px 16px;border:1px solid var(--hair);background:var(--panel);animation:tin .18s ease-out}
    @keyframes tin{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
    input[type=range]{-webkit-appearance:none;appearance:none;background:transparent;height:30px;width:100%}
    input[type=range]::-webkit-slider-runnable-track{height:1px;background:rgba(235,235,245,.34)}
    input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:14px;height:26px;margin-top:-13px;border-radius:0;background:var(--l1);cursor:ew-resize}
    /* Sidebar: persistent rail on desktop, overlay on a phone. Collapsed width
       is the icon column. The preference lives in a cookie so the first paint
       already matches — the same reason lang, theme and AI mode do. */
    /* dvh y no vh: en iOS Safari 100vh incluye la barra de direcciones, asi que
       el contenedor sale mas alto que el area visible y recorta por abajo. */
    .shell{display:flex;min-height:100dvh}
    .sidebar{width:248px;flex:none;border-right:1px solid var(--hair2);display:flex;flex-direction:column;position:sticky;top:0;height:100dvh;background:var(--bg);z-index:20;overflow:hidden}
    .sidebar-head{height:64px;display:flex;align-items:center;gap:4px;border-bottom:1px solid var(--hair2);flex:none}
    .sidebar-brand{height:64px;flex:1;min-width:0;display:flex;align-items:center;gap:11px;padding:0 8px 0 18px;color:var(--l1)}
    .sidebar-mark{width:26px;height:26px;flex:none;border:1px solid var(--hair);display:grid;place-items:center;font:700 12px/1 var(--f)}
    .sidebar-toggle,.sidebar-open{width:44px;height:44px;flex:none;display:grid;place-items:center;background:none;border:0;color:var(--l3);cursor:pointer;padding:0}
    .sidebar-toggle:hover,.sidebar-open:hover{color:var(--l1);background:var(--fill)}
    .sidebar-toggle:focus-visible,.sidebar-open:focus-visible{outline:2px solid var(--ac);outline-offset:2px}
    .sidebar-chevron{display:grid;transform:rotate(180deg)}
    .sidebar-x{display:none}
    .sidebar-nav{display:flex;flex-direction:column;padding:12px 0;gap:2px}
    .sidebar-foot{margin-top:auto;border-top:1px solid var(--hair2);padding:14px 16px;display:flex;flex-direction:column;gap:12px}
    .sidebar-user{display:flex;align-items:center;gap:11px;min-width:0}
    .sidebar-avatar{width:34px;height:34px;flex:none;border:1px solid var(--hair);display:grid;place-items:center;font:600 12px/1 var(--m)}
    .sidebar-who{display:flex;flex-direction:column;gap:4px;min-width:0}
    .sidebar-name{font:600 13px/1 var(--f);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .sidebar-backdrop{display:none}
    .sidebar-open{display:none}
    .app-head{height:64px;flex:none;border-bottom:1px solid var(--hair2);display:flex;align-items:center;justify-content:space-between;gap:20px;padding:0 28px;position:sticky;top:0;background:var(--bg);z-index:5}
    /* La "fila 2" de la cabecera en movil NO es un elemento propio: se consigue
       con flex-wrap sobre .app-head, porque <slot name="topbar"/> solo puede
       existir una vez (examen/[n].astro:25 lleva id="exam-score" y chat.astro:53
       un data-tut; dos copias romperian getElementById y el tutorial). Antes ese
       slot se borraba en movil con .app-head-tools{display:none} y con el se iban
       el conmutador Normal/IA de /chat y el marcador en vivo de /examen. */
    /* Con barra de accion las tres capas fijas de abajo suben por encima de
       ella. 68px = 44 del boton + 12+12 de padding. El gato lleva el estilo en
       linea desde cat.ts:167, asi que ahi hace falta !important. */
    html[data-action="1"] #toasts{bottom:calc(80px + env(safe-area-inset-bottom))}
    html[data-action="1"] #ia-capa{bottom:calc(80px + env(safe-area-inset-bottom))}
    /* #trazo-asoma lo crea cat.ts con estilo EN LINEA, asi que aqui hace falta
       !important: un id no le gana a un style="". */
    html[data-action="1"] #trazo-asoma{bottom:calc(78px + env(safe-area-inset-bottom))!important}
    /* Barra de accion inferior, en la zona del pulgar. Solo la usan las paginas
       cuya accion principal es un CTA de verdad: /panel y /curso. Los enlaces de
       conveniencia (logros, perfil, ligas, ranking) NO van aqui: su destino ya
       esta en el carril, y no justifican 44px permanentes. */
    .actionbar{display:none}
    .app-head-action{display:flex;align-items:center;gap:12px}
    /* En CSS y no en linea: un style="" le gana a la regla movil de mas abajo,
       y los dos .seg seguian comiendose la cabecera en un telefono. */
    .app-head-prefs{display:flex;align-items:center;gap:18px}
    .app-head-left{display:flex;align-items:center;gap:10px;min-width:0}
    .app-head-right{display:flex;align-items:center;gap:18px;min-width:0}
    .app-head-tools{display:flex;align-items:center;gap:12px}
    .shell[data-sidebar-collapsed="1"] .sidebar{width:64px}
    .shell[data-sidebar-collapsed="1"] .sidebar-head{flex-direction:column;height:auto;padding:8px 0;gap:0}
    .shell[data-sidebar-collapsed="1"] .sidebar-brand{height:48px;padding:0;justify-content:center}
    .shell[data-sidebar-collapsed="1"] .sidebar-copy{display:none}
    .shell[data-sidebar-collapsed="1"] .sidebar-toggle{width:100%;height:40px}
    .shell[data-sidebar-collapsed="1"] .sidebar-chevron{transform:none}
    .shell[data-sidebar-collapsed="1"] .nav,.shell[data-sidebar-collapsed="1"] .ia-nav{padding:0;justify-content:center;gap:0}
    .shell[data-sidebar-collapsed="1"] .ia-nav .ia-track{display:none}
    .shell[data-sidebar-collapsed="1"] .sidebar-foot{padding:12px 0;align-items:center}
    .shell[data-sidebar-collapsed="1"] .sidebar-user{justify-content:center}
    .shell[data-sidebar-collapsed="1"] #logout{width:100%;justify-content:center;padding:0}
    @media (min-width:901px){
      .shell[data-sidebar-collapsed="1"] #ia-capa{left:80px;max-width:calc(100vw - 104px)}
    }
    .app-pad{padding:30px 28px 40px}
    .stack-3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}
    .span-2{grid-column:span 2}
    .lec-list-head,.lec-list-row{display:grid;grid-template-columns:46px 1fr 190px 92px 104px;gap:18px}
    .ajustes-split{display:grid;grid-template-columns:200px 1fr;gap:34px;align-items:start}
    .ajustes-fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}
    .lec-top{display:flex;align-items:flex-end;justify-content:space-between;gap:24px}
    .lec-cols{display:grid;grid-template-columns:1fr 1fr;gap:22px;align-items:start}
    /* Rejillas que estaban escritas en linea pagina por pagina, sin media query
       que las rescatase. En .app-pad a 390 px hay 362 utiles, y con las pistas
       fijas mas los gaps se pasaban todas:
         .curso-card     60+300+44  = 404  -> el 1fr (titulo y labs) a 0
         .tbl-rank       460+64     = 524  -> desbordaba 162 px
         .tbl-admin      350+64     = 414  -> nombre y correo a 0
         .tbl-tutor      310+64     = 374  -> nombre y correo a 0
         .cerrada-split  320+24     = 344 contra 334 (muro de pago)
         .chat-split     300+24     = 324, y el 1fr del hilo se quedaba corto
         .perfil-stats   4 columnas de 74 menos 44 de padding = 30 de contenido */
    .curso-card{display:grid;grid-template-columns:60px minmax(0,1fr) 300px;gap:22px;align-items:start}
    .cerrada-split{display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:24px;align-items:start}
    .chat-split{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:24px;align-items:start}
    .perfil-stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:22px}
    .perfil-split{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(0,1fr);gap:24px;align-items:start}
    .tutor-split{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(0,1fr);gap:24px;align-items:start}
    .soporte-2{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:22px}
    .tbl-rank{display:grid;grid-template-columns:70px 1fr 190px 110px 90px;gap:16px}
    .tbl-admin{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1.6fr) 150px 110px 90px;gap:16px}
    .tbl-tutor{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(0,1.4fr) 90px 110px 110px;gap:16px}
    @media (max-width:900px){
      .app-pad{padding:18px 14px 32px}
      .stack-3,.ajustes-split,.ajustes-fields,.lec-cols{grid-template-columns:1fr}
      .span-2{grid-column:auto}
      .lec-list-head{display:none}
      .lec-list-row{grid-template-columns:46px 1fr auto;height:auto;padding:12px 4px;gap:10px 12px}
      .lec-labs,.lec-count{display:none}
      .lec-top{flex-direction:column;align-items:stretch}
      .lec-math{width:auto!important}
      .toast{width:min(372px, calc(100vw - 24px))}
      .input{font-size:16px}
      .sidebar-open{display:grid}
      .sidebar-chevron{display:none}
      .sidebar-x{display:grid}
      .sidebar{position:fixed;left:0;top:0;height:100%;width:min(248px,86vw);transform:translateX(-110%);visibility:hidden;box-shadow:none;z-index:40}
      .shell[data-nav-open="1"] .sidebar{transform:translateX(0);visibility:visible}
      .sidebar-backdrop{display:block;position:fixed;inset:0;background:rgba(0,0,0,.46);z-index:30;border:0;padding:0;cursor:pointer}
      .sidebar-backdrop[hidden]{display:none}
      .shell[data-sidebar-collapsed="1"] .sidebar{width:min(248px,86vw)}
      .shell[data-sidebar-collapsed="1"] .sidebar-head{flex-direction:row;height:64px;padding:0}
      .shell[data-sidebar-collapsed="1"] .sidebar-brand{height:64px;padding:0 8px 0 18px;justify-content:flex-start}
      .shell[data-sidebar-collapsed="1"] .sidebar-copy{display:unset}
      .shell[data-sidebar-collapsed="1"] .sidebar-who{display:flex}
      .shell[data-sidebar-collapsed="1"] .sidebar-toggle{width:44px;height:44px}
      .shell[data-sidebar-collapsed="1"] .nav,.shell[data-sidebar-collapsed="1"] .ia-nav{padding:0 16px;justify-content:flex-start;gap:11px}
      .shell[data-sidebar-collapsed="1"] .ia-nav .ia-track{display:inline-flex}
      .shell[data-sidebar-collapsed="1"] .sidebar-foot{padding:14px 16px;align-items:stretch}
      .shell[data-sidebar-collapsed="1"] .sidebar-user{justify-content:flex-start}
      .shell[data-sidebar-collapsed="1"] #logout{width:auto;justify-content:flex-start;padding:0}
      /* Cabecera de DOS filas, conseguida con wrap y no duplicando el slot:
         <slot name="topbar"/> solo puede existir una vez (examen/[n].astro:25
         lleva id="exam-score" y chat.astro:53 un data-tut; dos copias romperian
         getElementById y el tutorial). .app-head-right pasa a flex-basis:100%,
         asi que cae entera a la segunda linea con el slot dentro. */
      .app-head{height:auto;flex-wrap:wrap;align-items:center;gap:0;padding:0}
      .app-head-left{flex:1 1 auto;min-width:0;height:56px;padding:0 12px 0 4px}
      /* La miga VUELVE. Sin carril lateral es la unica orientacion que queda; lo
         que le comia el sitio eran los dos .seg, que en movil se van a /ajustes
         (esta en el NAV, y ajustes.astro:47 y :74 tienen los mismos controles
         como .chip de 44px, no como .segb de 30). */
      .app-head-left .lbl{display:unset;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
      .app-head-right{flex:1 1 100%;gap:0;padding:0}
      .app-head-prefs{display:none}
      /* Esto sustituye al viejo .app-head-tools{display:none}, que se llevaba
         por delante el conmutador Normal/IA de /chat y el marcador de /examen. */
      .app-head-tools{display:flex;width:100%;align-items:center;gap:10px;padding:10px 14px;border-top:1px solid var(--hair2)}
      .app-head-tools:empty{display:none}
      .app-head-tools .seg{width:100%}
      .app-head-tools .segb{flex:1}
      .segb{height:44px;padding:0 16px}
      /* Barra de accion en la zona del pulgar. Solo /panel y /curso. */
      .actionbar{display:flex;align-items:center;gap:12px;position:sticky;bottom:0;z-index:6;
        background:var(--bg);border-top:1px solid var(--hair2);
        padding:12px 14px calc(12px + env(safe-area-inset-bottom))}
      .actionbar:empty{display:none}
      .actionbar > *{flex:1}
      /* El CTA que la barra ya carga se esconde dentro de la tarjeta para no
         mostrar dos botones identicos a la vez. */
      /* En movil manda la barra inferior, asi que la copia de la cabecera se
         apaga. Cada anchura ensena exactamente una. */
      .app-head-action{display:none}
      .curso-card,.cerrada-split,.chat-split,.perfil-split,.tutor-split,.soporte-2{grid-template-columns:minmax(0,1fr)}
      /* 2 y no 4: a 362 px cuatro columnas dan 74 por tarjeta, y .card gasta 44
         en padding. Dentro hay numeros a font:700 34px, que piden ~90. */
      .perfil-stats{grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
      /* El ranking lo ve el alumno y son cinco valores cortos: se reordena a dos
         filas por jugador, sin esconder ningun dato. */
      .tbl-rank{grid-template-columns:34px 1fr auto;gap:5px 12px;height:auto!important;padding:12px 4px!important}
      .tbl-rank-head{display:none}
      /* Colocacion explicita para que las cinco celdas quepan en dos filas sin
         esconder ninguna. Sin esto el auto-placement las reparte a 3 por fila y
         el rango termina bajo el puesto. */
      .tbl-rank > :nth-child(1){grid-area:1/1}
      .tbl-rank > :nth-child(2){grid-area:1/2/2/3}
      .tbl-rank > :nth-child(3){grid-area:1/3;justify-self:end}
      .tbl-rank > :nth-child(4){grid-area:2/2}
      .tbl-rank > :nth-child(5){grid-area:2/3;justify-self:end}
      /* Admin y tutor son herramientas internas con tablas densas de verdad
         (nombre, correo, fechas). Apilarlas las vuelve ilegibles: scroll
         horizontal dentro de su propio contenedor, que es el trato correcto
         para una tabla, y el body nunca desborda. */
      /* Un hijo de flex o grid trae min-width:auto, o sea que NO puede encoger
         por debajo de su max-content: una linea larga infla al padre en vez de
         partirse. En .card de /soporte eso daba un hijo de 301px dentro de una
         tarjeta de 256 y 37px de desborde a 320. Es el mismo fallo que el 1fr
         desnudo de arriba, en su version flex, y se cierra igual: dejar encoger.
         Solo hijos directos: no toca rejillas internas ni .tblwrap, que necesita
         su min-width para tener algo que desplazar. */
      .card > *:not(.tblwrap){min-width:0}
      .tblwrap{overflow-x:auto;-webkit-overflow-scrolling:touch}
      .tblwrap > *{min-width:620px}
    }
    /* Banda de tablet 901-1180: el carril arranca contraido. A 1024 un carril de
       248 deja 776, y stack-3 daria tres tarjetas de 232 cuando el parrafo del
       heroe pide 560. Contraido a 64 quedan 960 y dos columnas leen bien.
       Solo actua cuando el usuario NO ha elegido: data-sidebar-rail="auto". */
    @media (min-width:901px) and (max-width:1180px){
      .shell[data-sidebar-rail="auto"] .sidebar{width:64px}
      .shell[data-sidebar-rail="auto"] .sidebar-head{flex-direction:column;height:auto;padding:8px 0;gap:0}
      .shell[data-sidebar-rail="auto"] .sidebar-brand{height:48px;padding:0;justify-content:center}
      .shell[data-sidebar-rail="auto"] .sidebar-copy{display:none}
      .shell[data-sidebar-rail="auto"] .sidebar-toggle{width:100%;height:40px}
      .shell[data-sidebar-rail="auto"] .sidebar-chevron{transform:none}
      .shell[data-sidebar-rail="auto"] .nav,
      .shell[data-sidebar-rail="auto"] .ia-nav{padding:0;justify-content:center;gap:0}
      .shell[data-sidebar-rail="auto"] .ia-nav .ia-track{display:none}
      .shell[data-sidebar-rail="auto"] .sidebar-foot{padding:12px 0;align-items:center}
      .shell[data-sidebar-rail="auto"] .sidebar-user{justify-content:center}
      .shell[data-sidebar-rail="auto"] #logout{width:100%;justify-content:center;padding:0}
      .stack-3{grid-template-columns:repeat(2,minmax(0,1fr))}
      .span-2{grid-column:span 2}
    }
    @media (prefers-reduced-motion: no-preference){
      .sidebar{transition:width .16s ease-out,transform .16s ease-out}
    }
  </style>
</head>
<body>
  <div id="app-shell" class="shell" data-sidebar-rail={rail} data-sidebar-collapsed={railCollapsed ? '1' : undefined}>
    <div id="sidebar-backdrop" class="sidebar-backdrop" hidden></div>
    <aside id="app-sidebar" class="sidebar">
      <div class="sidebar-head">
        <a href="/panel" class="sidebar-brand" aria-label="IA desde cero">
          <span class="sidebar-mark">IA</span>
          <span class="sidebar-copy" style="font:600 13px/1.2 var(--f)">IA desde cero</span>
        </a>
        <button id="sidebar-toggle" class="sidebar-toggle" type="button"
                aria-controls="app-sidebar"
                aria-expanded={railCollapsed ? 'false' : 'true'}
                aria-label={railCollapsed ? L.ui.menuExpandir : L.ui.menuContraer}
                data-label-close={L.ui.menuCerrar}
                data-label-collapse={L.ui.menuContraer}
                data-label-expand={L.ui.menuExpandir}>
          <span class="sidebar-chevron"><Fragment set:html={icon('arrow', 16)} /></span>
          <span class="sidebar-x"><Fragment set:html={icon('x', 16)} /></span>
        </button>
      </div>
      <nav class="sidebar-nav">
        {NAV.map((n) => (
          <a href={n.href} class="nav" title={n.label} aria-label={n.label}
             aria-current={n.label === active ? 'page' : undefined}>
            <Fragment set:html={icon(n.ic, 18)} />
            <span class="sidebar-copy">{n.label}</span>
          </a>
        ))}
        <button id="ia-toggle" class="ia-nav" type="button" role="switch" data-tut="panel-4"
                aria-checked={ia.mode ? 'true' : 'false'} title={L.ia.modoAria}
                aria-label={L.ia.modoAria}>
          <Fragment set:html={icon('spark', 18)} />
          <span class="sidebar-copy">{L.ia.modo}</span>
          <span class="ia-track" aria-hidden="true"><span class="ia-knob"></span></span>
        </button>
      </nav>
      <div class="sidebar-foot">
        <div class="sidebar-user">
          <div class="sidebar-avatar">{initials(user.name)}</div>
          <div class="sidebar-who sidebar-copy">
            <div class="sidebar-name">{user.name}</div>
            <div class="lbl" style="color:var(--ac)">{ROL[user.role] ?? user.role}</div>
          </div>
        </div>
        <button id="logout" class="nav" style="border-left:0;padding:0;height:32px;background:none;border:0;cursor:pointer;text-align:left"
                aria-label={L.salir} title={L.salir}>
          <Fragment set:html={icon('logout', 16)} />
          <span class="sidebar-copy">{L.salir}</span>
        </button>
      </div>
    </aside>
    <script is:inline>
      (() => {
        const rail = document.getElementById('app-sidebar');
        if (rail && matchMedia('(max-width:900px)').matches) rail.setAttribute('inert', '');
      })();
    </script>

    <main style="flex:1;min-width:0;display:flex;flex-direction:column">
      <header class="app-head">
        <div class="app-head-left">
          <button id="sidebar-open" class="sidebar-open" type="button"
                  aria-controls="app-sidebar" aria-expanded="false"
                  aria-label={L.ui.menuAbrir}>
            <Fragment set:html={icon('menu', 18)} />
          </button>
          <div class="lbl">{crumb}</div>
        </div>
        <div class="app-head-right">
          <!-- Los dos .seg viven aqui en escritorio. En movil se esconden con
               .app-head-prefs{display:none}: los mismos controles estan en
               /ajustes, que esta en el carril, y ahi son .chip de 44px en vez de
               .segb de 30. Asi la fila 1 queda para hamburguesa + miga. -->
          <div class="app-head-prefs">

          <div class="seg" role="group" aria-label={L.idioma}>
            <button class="segb" data-pref="lang" data-val="auto" aria-pressed={user.lang === 'auto'}>{L.automatico}</button>
            {IDIOMAS.map((c) => (
              <button class="segb" data-pref="lang" data-val={c} aria-pressed={user.lang === c}>{NOMBRE_IDIOMA[c] ?? c.toUpperCase()}</button>
            ))}
          </div>

          <div class="seg" role="group" aria-label={L.tema}>
            <button class="segb" data-pref="theme" data-val="auto" aria-pressed={user.theme === 'auto'} title={L.siguiendoEquipo}>{L.automatico}</button>
            <button class="segb" data-pref="theme" data-val="dark" aria-pressed={user.theme === 'dark'}>{L.oscuro}</button>
            <button class="segb" data-pref="theme" data-val="paper" aria-pressed={user.theme === 'paper'}>{L.papel}</button>
          </div>

          </div>

          <div class="app-head-tools"><slot name="topbar" /></div>
          <div class="app-head-action" set:html={actionHtml}></div>
        </div>
      </header>
      <slot />
      <!-- Barra de accion inferior (opcion A). Solo la usan /panel y /curso: las
           dos paginas cuya accion principal es un CTA de verdad. Los enlaces de
           conveniencia van al slot topbar (opcion B), porque su destino ya esta
           en el carril y no justifican 44px permanentes de pantalla. -->
      <div class="actionbar" set:html={actionHtml}></div>
    </main>
  </div>

  <div id="toasts"></div>
  <AiPanel lang={lang} flags={ia} nombre={user.name.split(' ')[0] ?? ''} />

  <script type="application/json" id="txt" is:inline set:html={jsonSafe({ ...L.avisos, auto: L.automatico, dark: L.oscuro, paper: L.papel })}></script>

  <script>
    import { animarIdioma } from '../lib/lang-anim';
    import { writeSidebarCollapsed } from '../lib/sidebar';
    import { montarAvisos } from '../lib/avisos';

    const T = JSON.parse(document.getElementById('txt')!.textContent!) as Record<string, string>;
    montarAvisos(T.cerrar ?? 'Cerrar');
    // Toggles de idioma y tema. El tema se aplica al instante sobre <html data-theme>;
    // el idioma necesita recarga porque las cadenas se resuelven en el servidor.
    document.querySelectorAll<HTMLElement>('.segb[data-pref]').forEach((b) => b.addEventListener('click', async () => {
      const pref = b.dataset.pref!, val = b.dataset.val!;
      if (b.getAttribute('aria-pressed') === 'true') return;
      const group = b.parentElement!;
      const prev = group.querySelector<HTMLElement>('[aria-pressed="true"]');
      group.querySelectorAll('.segb').forEach((x) => x.setAttribute('aria-pressed', 'false'));
      b.setAttribute('aria-pressed', 'true');
      if (pref === 'theme') document.documentElement.setAttribute('data-theme', val);

      const res = await fetch('/api/settings', {
        method: 'PATCH', headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ [pref]: val }),
      });
      if (!res.ok) {
        group.querySelectorAll('.segb').forEach((x) => x.setAttribute('aria-pressed', 'false'));
        prev?.setAttribute('aria-pressed', 'true');
        if (pref === 'theme') document.documentElement.setAttribute('data-theme', prev?.dataset.val ?? 'auto');
        (window as any).toast('bad', T.noGuardo, T.noGuardoB, 'pref');
        return;
      }
      if (pref === 'lang') { await animarIdioma(b, val); location.reload(); return; }
      const auto = val === 'auto' ? T.temaSig : '';
      (window as any).toast('ok', T.temaOk, `${T[val] ?? val}${auto}.`, 'pref');
    }));

    document.getElementById('logout')!.onclick = async () => {
      await fetch('/api/auth/logout', { method: 'POST' });
      (window as any).toast('info', T.salio, T.salioB);
      setTimeout(() => location.assign('/login'), 500);
    };

    const shell = document.getElementById('app-shell')!;
    const rail = document.getElementById('app-sidebar') as HTMLElement;
    const backdrop = document.getElementById('sidebar-backdrop')!;
    const openBtn = document.getElementById('sidebar-open') as HTMLButtonElement;
    const toggleBtn = document.getElementById('sidebar-toggle') as HTMLButtonElement;
    const phone = window.matchMedia('(max-width:900px)');
    const LABEL = {
      abrir: openBtn.getAttribute('aria-label') ?? '',
      cerrar: toggleBtn.dataset.labelClose ?? '',
      contraer: toggleBtn.dataset.labelCollapse ?? '',
      expandir: toggleBtn.dataset.labelExpand ?? '',
    };
    const navOpen = () => shell.getAttribute('data-nav-open') === '1';
    const railClosed = () => shell.getAttribute('data-sidebar-collapsed') === '1';

    const sync = () => {
      if (phone.matches) {
        const on = navOpen();
        openBtn.setAttribute('aria-expanded', on ? 'true' : 'false');
        openBtn.setAttribute('aria-label', on ? LABEL.cerrar : LABEL.abrir);
        toggleBtn.setAttribute('aria-expanded', on ? 'true' : 'false');
        toggleBtn.setAttribute('aria-label', LABEL.cerrar);
        backdrop.hidden = !on;
        document.body.style.overflow = on ? 'hidden' : '';
        rail.toggleAttribute('inert', !on);
      } else {
        const expanded = !railClosed();
        openBtn.setAttribute('aria-expanded', expanded ? 'true' : 'false');
        toggleBtn.setAttribute('aria-expanded', expanded ? 'true' : 'false');
        toggleBtn.setAttribute('aria-label', expanded ? LABEL.contraer : LABEL.expandir);
        backdrop.hidden = true;
        document.body.style.overflow = '';
        shell.removeAttribute('data-nav-open');
        rail.removeAttribute('inert');
      }
    };
    const setNav = (on: boolean) => {
      if (on) shell.setAttribute('data-nav-open', '1');
      else shell.removeAttribute('data-nav-open');
      sync();
      (on ? toggleBtn : openBtn).focus();
    };
    const setRail = (on: boolean) => {
      if (on) shell.setAttribute('data-sidebar-collapsed', '1');
      else shell.removeAttribute('data-sidebar-collapsed');
      writeSidebarCollapsed(on);
      sync();
    };

    openBtn.addEventListener('click', () => {
      if (phone.matches) setNav(!navOpen());
      else setRail(false);
    });
    toggleBtn.addEventListener('click', () => {
      if (phone.matches) setNav(false);
      else setRail(!railClosed());
    });
    backdrop.addEventListener('click', () => setNav(false));
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      if (phone.matches && navOpen()) { e.preventDefault(); setNav(false); }
    });
    phone.addEventListener('change', sync);
    sync();
  </script>
</body>
</html>
