<!-- Los datos de la landing, ya resueltos al idioma de esta peticion. El script
     de abajo los lee de aqui en vez de importarlos: un import se resuelve en
     build y dejaba la pagina clavada en un idioma. jsonSafe escapa para que un
     </script> dentro de una cadena no pueda cerrar la etiqueta. -->
<script type="application/json" id="land-datos" is:inline set:html={jsonSafe(DATOS)}></script>

<script>
import { gsap } from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';
import type { Module, Candidate, Faq } from '../data/landing';
// Los datos NO se importan: llegaban resueltos en build y en un solo idioma, que
// es por lo que la landing solo podia estar en español. Viajan como JSON en el
// documento, el mismo patron que usa /pago para el texto del tutorial.
// El tipo va a mano porque JSON.parse devuelve `any` y sin esto los .map de mas
// abajo pierden el tipo del elemento. El import de tipos se borra al compilar,
// asi que no arrastra el modulo de datos al bundle del navegador.
type Datos = {
  modulos: Module[]; candidatos: Candidate[]; faqs: Faq[];
  micro: string[]; ticker: string[]; txt: Record<string, string>;
};
const D = JSON.parse(document.getElementById('land-datos')!.textContent!) as Datos;
const MODULES = D.modulos, CANDS = D.candidatos, FAQS = D.faqs, MICRO = D.micro, TICKER = D.ticker, TXT = D.txt;

gsap.registerPlugin(ScrollTrigger);
(window as any).gsap = gsap;
(window as any).ScrollTrigger = ScrollTrigger;

const esc = (s: unknown) => String(s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");

/* ---- static lists ---- */
document.getElementById("introgrid")!.innerHTML = MICRO.map(m =>
  `<div class="mcell" style="display:flex;align-items:center;justify-content:center;text-align:center;padding:2px;border:1px solid rgba(84,84,88,.30);font:500 8px/1.15 var(--m);letter-spacing:.10em;color:rgba(235,235,245,.70);overflow:hidden;opacity:0">${esc(m)}</div>`).join("");

const tickerHTML = TICKER.map(t => `<span>${esc(t)}</span>`).join("");
document.getElementById("ticker1")!.innerHTML = tickerHTML;
document.getElementById("ticker2")!.innerHTML = tickerHTML;

document.getElementById("modules")!.innerHTML = MODULES.map(m =>
  `<div data-row class="row-h" style="display:grid;grid-template-columns:52px 1.05fr 1.25fr 250px;gap:24px;padding:22px 0;border-bottom:1px solid var(--hair2);align-items:start">
    <div style="font:700 15px/1.2 var(--m);letter-spacing:.02em;color:var(--l3)">${m.n}</div>
    <div style="display:flex;flex-direction:column;gap:7px">
      <div style="font:600 10px/1 var(--m);letter-spacing:.18em;color:var(--ac)">${esc(m.eb)}</div>
      <div style="font:700 21px/1.16 var(--f);letter-spacing:-.028em">${esc(m.h)}</div>
    </div>
    <div style="font:400 16px/1.5 var(--f);color:var(--l2);padding-top:2px">${esc(m.d)}</div>
    <div style="display:flex;flex-direction:column;gap:6px">
      <div style="font:600 17px/1.15 var(--m);letter-spacing:-.01em;font-variant-numeric:tabular-nums">${esc(m.k)}</div>
      <div style="font:400 12px/1.45 var(--f);color:var(--l3)">${esc(m.kc)}</div>
    </div>
  </div>`).join("");

/* ---- FAQ accordion ---- */
let faqOpen = -1;
const faqsEl = document.getElementById("faqs")!;
function renderFaqs(){
  faqsEl.innerHTML = FAQS.map((f,i) =>
    `<div style="border-bottom:1px solid var(--hair2)">
      <div class="row-h" data-faq="${i}" style="display:grid;grid-template-columns:52px 1fr 30px;gap:24px;align-items:center;padding:22px 0;cursor:pointer">
        <div style="font:600 11px/1 var(--m);letter-spacing:.14em;color:var(--l3)">${String(i+1).padStart(2,"0")}</div>
        <div style="font:600 19px/1.3 var(--f);letter-spacing:-.02em">${esc(f.q)}</div>
        <div style="justify-self:end;font:500 15px/1 var(--m);color:var(--l3)">${faqOpen===i?"−":"+"}</div>
      </div>
      <div style="max-height:${faqOpen===i?"300px":"0px"};overflow:hidden;transition:max-height .3s ease">
        <div style="display:grid;grid-template-columns:52px 1fr 30px;gap:24px;padding:0 0 24px">
          <div></div><div style="font:400 16px/1.55 var(--f);color:var(--l2);max-width:680px">${esc(f.a)}</div><div></div>
        </div>
      </div>
    </div>`).join("");
}
renderFaqs();
faqsEl.addEventListener("click", e => {
  const row = (e.target as HTMLElement).closest("[data-faq]");
  if(!row) return;
  const i = +row.getAttribute("data-faq")!;
  faqOpen = (faqOpen === i) ? -1 : i;
  renderFaqs();
});

/* ---- specimen A: tokenizer ---- */
function tokenize(s: string){
  const out: string[] = [];
  (s || "").trim().split(/\s+/).filter(Boolean).forEach(w => {
    if(w.length <= 4){ out.push(w); return; }
    let i = 0;
    while(i < w.length){ const take = i===0 ? 5 : 4; out.push(w.slice(i, i+take)); i += take; }
  });
  return out.slice(0, 26);
}
const tokinEl = document.getElementById("tokin") as HTMLInputElement;
const tokensEl = document.getElementById("tokens")!;
function renderTokens(){
  const txt = tokinEl.value;
  const toks = tokenize(txt);
  tokensEl.innerHTML = toks.map(t =>
    `<div style="border:1px solid var(--hair);color:var(--l1);font:500 15px/1 var(--m);padding:11px 12px">${esc(t)}</div>`).join("");
  document.getElementById("tokenCount")!.textContent = String(toks.length);
  document.getElementById("wordCount")!.textContent = txt.trim() ? String(txt.trim().split(/\s+/).length) : "0";
  document.getElementById("charCount")!.textContent = String(txt.replace(/\s/g,"").length);
}
tokinEl.value = TXT.ejemplo;
tokinEl.addEventListener("input", renderTokens);
renderTokens();

/* ---- specimen B: temperature softmax ---- */
const tempinEl = document.getElementById("tempin") as HTMLInputElement;
const candsEl = document.getElementById("cands")!;
function renderTemp(){
  const T = (+tempinEl.value) / 100;
  const ex = CANDS.map(c => Math.exp(c.logit / Math.max(.08, T)));
  const sum = ex.reduce((a,b)=>a+b, 0);
  candsEl.innerHTML = CANDS.map((c,i) => {
    const p = ex[i]/sum, pct = p*100;
    const pctTxt = pct >= 9.5 ? Math.round(pct)+"%" : (pct < .5 ? "~0%" : pct.toFixed(1)+"%");
    const w = Math.max(1.2, pct)+"%";
    const bar = i===0 ? "#0A84FF" : "rgba(235,235,245,.55)";
    const color = i===0 ? "#fff" : (p > .08 ? "rgba(235,235,245,.62)" : "rgba(235,235,245,.38)");
    return `<div style="display:grid;grid-template-columns:130px 1fr 62px;gap:14px;align-items:center;padding:9px 0;border-bottom:1px solid var(--hair2)">
      <div style="font:500 15px/1.2 var(--f);color:${color}">${esc(c.name)}</div>
      <div style="height:7px;background:rgba(120,120,128,.20)"><div style="width:${w};height:100%;background:${bar};transition:width .18s ease-out"></div></div>
      <div style="text-align:right;font:500 13px/1 var(--m);color:${color};font-variant-numeric:tabular-nums">${pctTxt}</div>
    </div>`;
  }).join("");
  document.getElementById("tempLabel")!.textContent = T.toFixed(2);
    document.getElementById("tempVerdict")!.textContent = T < .5 ? TXT.predecible : (T < 1.05 ? TXT.equilibrada : TXT.impredecible);
}
tempinEl.addEventListener("input", renderTemp);
renderTemp();

/* ---- effects: grain + particle cover ---- */
function mountGrain(){
  document.querySelectorAll('canvas[data-fx="grain"]').forEach(cv => {
    const c = cv as HTMLCanvasElement;
    const ctx = c.getContext("2d"); if(!ctx) return;
    const paint = () => {
      const w = c.clientWidth, h = c.clientHeight; if(!w || !h) return;
      c.width = w; c.height = h;
      const img = ctx.createImageData(w, h), d = img.data;
      for(let i=0;i<d.length;i+=4){ const v = Math.random()*255|0; d[i]=d[i+1]=d[i+2]=v; d[i+3]=255; }
      ctx.putImageData(img, 0, 0);
    };
    paint();
    let tm: any=null; window.addEventListener("resize", ()=>{ clearTimeout(tm); tm=setTimeout(paint,180); });
  });
}

function mountCover(){
  const cv = document.querySelector('canvas[data-fx="cover"]') as HTMLCanvasElement | null;
  if(!cv) return;
  const ctx = cv.getContext("2d"); if(!ctx) return;
  const sizeCanvas = () => {
    const dpr = Math.min(window.devicePixelRatio || 1, 1.7);
    const w = Math.max(1, Math.round(cv.clientWidth*dpr)), h = Math.max(1, Math.round(cv.clientHeight*dpr));
    if(cv.width!==w || cv.height!==h){ cv.width=w; cv.height=h; }
  };
  const stars: any[] = [];
  for(let i=0;i<190;i++) stars.push({x:Math.random(),y:Math.random(),r:Math.random(),s:.4+Math.random()});
  const ring = () => { const out: any[]=[]; for(let i=0;i<900;i++){ const a=Math.random()*Math.PI*2, rr=.22+Math.random()*.06; out.push({tx:Math.cos(a)*rr,ty:Math.sin(a)*rr}); } return out; };
  let targets: any[] | null = null, P: any[] = [];
  const build = () => {
    P = targets!.map(tg => {
      const a=Math.random()*Math.PI*2, rr=.55+Math.random()*.75;
      return { tx:tg.tx, ty:tg.ty, vx:Math.cos(a)*rr, vy:Math.sin(a)*rr*1.25, r:Math.random(), sp:.55+Math.random()*.9 };
    });
  };
  // Se DIBUJA la marca en vez de cargarla. Sin imagen no hay carga que esperar
  // ni que pueda fallar, asi que el camino de onerror deja de existir: el unico
  // fallback que queda es el try/catch, para el navegador que niegue el canvas.
  const marca = () => {
    const S=104, off=document.createElement("canvas"); off.width=S; off.height=S;
    const oc=off.getContext("2d")!;
    oc.fillStyle="#000"; oc.fillRect(0,0,S,S);
    // Las mismas proporciones que la clase .lg: borde .04 y texto .46 del lado,
    // que son las de .mark en theme-css.ts (caja 26 -> texto 12, borde 1).
    oc.strokeStyle="#fff"; oc.lineWidth=Math.max(2,S*.04);
    const m=S*.13; oc.strokeRect(m,m,S-2*m,S-2*m);
    oc.fillStyle="#fff"; oc.textAlign="center"; oc.textBaseline="middle";
    oc.font='700 ' + Math.round(S*.46) + "px -apple-system,'SF Pro Display',system-ui,sans-serif";
    oc.fillText("IA", S/2, S/2);
    return oc.getImageData(0,0,S,S).data;
  };
  const sembrar = () => {
    try {
      const S=104;
      const d=marca(), found: any[]=[];
      let x0=S,x1=0,y0=S,y1=0;
      for(let y=0;y<S;y++) for(let x=0;x<S;x++){
        const i=(y*S+x)*4, lum=(d[i]*.299+d[i+1]*.587+d[i+2]*.114)*(d[i+3]/255);
        if(lum>112){ found.push({px:x,py:y}); if(x<x0)x0=x; if(x>x1)x1=x; if(y<y0)y0=y; if(y>y1)y1=y; }
      }
      const span=Math.max(1,x1-x0,y1-y0), k=.70/span, mx=(x0+x1)/2, my=(y0+y1)/2;
      found.forEach(f => { f.tx=(f.px-mx)*k; f.ty=(f.py-my)*k; });
      for(let i=found.length-1;i>0;i--){ const j=Math.random()*(i+1)|0; const t=found[i]; found[i]=found[j]; found[j]=t; }
      targets = found.length>240 ? found.slice(0,1600) : ring();
    } catch(e){ targets = ring(); }
    build();
  };
  sembrar();
  sizeCanvas();
  window.addEventListener("resize", sizeCanvas);
  const ease = (u: number) => u<.5 ? 2*u*u : 1-Math.pow(-2*u+2,2)/2;
  const t0 = performance.now();
  function frame(){
    const t = (performance.now()-t0)/1000, W=cv!.width, H=cv!.height;
    ctx!.globalCompositeOperation="source-over"; ctx!.fillStyle="#000"; ctx!.fillRect(0,0,W,H);
    ctx!.globalCompositeOperation="lighter";
    for(let i=0;i<stars.length;i++){ const s=stars[i]; const a=.03+.11*Math.abs(Math.sin(t*.5*s.s+s.r*6.28)); ctx!.fillStyle="rgba(255,255,255,"+a.toFixed(3)+")"; ctx!.fillRect(s.x*W,s.y*H,1.3,1.3); }
    if(P.length){
      const cyc=9.6, u=(t%cyc)/cyc;
      let form; if(u<.26) form=ease(u/.26); else if(u<.64) form=1; else if(u<.86) form=1-ease((u-.64)/.22); else form=0;
      const cx=W*.5, cy=H*.40, sc=Math.min(W,H)*1.10;
      for(let i=0;i<P.length;i++){ const p=P[i];
        const jx=Math.sin(t*(.7+p.sp)+p.r*6.3)*.006, jy=Math.cos(t*(.6+p.sp)+p.r*4.1)*.006;
        const dx=p.vx+Math.sin(t*.25*p.sp+p.r*6.3)*.16, dy=p.vy+t*.012*p.sp*.4;
        const x=(p.tx+jx)*form+dx*(1-form), y=(p.ty+jy)*form+dy*(1-form);
        const a=(.10+form*.68)*(.45+p.r*.7), sz=(.9+p.r*1.1)*(W/700)*1.5;
        ctx!.fillStyle="rgba(255,255,255,"+a.toFixed(3)+")"; ctx!.fillRect(cx+x*sc, cy+y*sc, sz, sz);
      }
    }
    requestAnimationFrame(frame);
  }
  requestAnimationFrame(frame);
}

/* ---- loader ---- */
const INTRO_SKIP = "ia_intro_skip";
function endIntroNow(){
  (window as any).__introDone = true;
  try { sessionStorage.setItem(INTRO_SKIP, "1"); } catch {}
  const ov = document.querySelector('[data-el="intro"]') as HTMLElement | null;
  if(ov){ ov.style.opacity="0"; ov.style.display="none"; }
  document.documentElement.style.overflow = "";
  if((window as any).ScrollTrigger) ScrollTrigger.refresh();
}
document.getElementById("skip")!.addEventListener("click", endIntroNow);
document.getElementById("skip")!.addEventListener("keydown", (e) => {
  if (e.key === "Enter" || e.key === " ") { e.preventDefault(); endIntroNow(); }
});

function runIntro(){
  const ov = document.querySelector('[data-el="intro"]');
  if(!ov) return;
  // No animation lib (offline / bundle failed) → skip the loader, show the page.
  if(!(window as any).gsap){ endIntroNow(); return; }
  try { if (sessionStorage.getItem(INTRO_SKIP)) { endIntroNow(); return; } } catch {}
  if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) { endIntroNow(); return; }
  document.documentElement.style.overflow = "hidden";
  window.scrollTo(0,0);
  const bail = setTimeout(endIntroNow, 6500);
  const grid = document.querySelector('[data-el="introgrid"]');
  const logo = document.querySelector('[data-el="intrologo"]');
  const word = document.querySelector('[data-el="introword"]');
  const cells = ov.querySelectorAll(".mcell");
  const rs = ov.querySelector('[data-split="r"]'), bs = ov.querySelector('[data-split="b"]');
  const tl = gsap.timeline({ onComplete: () => { clearTimeout(bail); endIntroNow(); } });
  tl.to(cells, { opacity:1, duration:.45, ease:"none", stagger:{ amount:.75, from:"random" } }, 0)
    .to(cells, { opacity:.16, duration:.5, ease:"none", stagger:{ amount:.45, from:"random" } }, 1.00)
    .to(grid, { scale:1.28, opacity:0, duration:1.05, ease:"power2.in" }, 1.10)
    .fromTo(logo, { scale:13, opacity:0, filter:"blur(26px)" }, { scale:1, opacity:1, filter:"blur(0px)", duration:1.25, ease:"expo.out" }, 1.00)
    .fromTo(rs, { x:-30 }, { x:0, duration:1.15, ease:"expo.out" }, 1.00)
    .fromTo(bs, { x:30 }, { x:0, duration:1.15, ease:"expo.out" }, 1.00)
    .to(logo, { scale:.40, duration:.60, ease:"power3.inOut" }, 2.15)
    .to(word, { clipPath:"inset(0 0% 0 0)", duration:.55, ease:"power3.out" }, 2.35)
    .to(ov, { opacity:0, duration:.55, ease:"power2.inOut" }, 3.05);
}

/* ---- scroll ---- */
function initScroll(){
  if(!(window as any).gsap || !(window as any).ScrollTrigger) return;
  gsap.registerPlugin(ScrollTrigger);
  const bar = document.querySelector('[data-el="bar"]');
  const pct = document.querySelector('[data-el="pct"]')!;
  const sticky = document.querySelector('[data-el="sticky"]');
  gsap.set(bar, { scaleX:0, transformOrigin:"left center" });
  let stickyShown: boolean | null = null, primed = false;
  const drive = (self: any) => {
    gsap.set(bar, { scaleX: self.progress });
    pct.textContent = String(Math.round(self.progress*100)).padStart(3,"0") + "%";
    if(!primed){ primed = true; gsap.set(sticky, { y:0, yPercent:110 }); }
    const show = self.scroll() > window.innerHeight * .9;
    if(show === stickyShown) return;
    stickyShown = show;
    gsap.to(sticky, { yPercent: show?0:110, duration:.42, ease:"power3.out", overwrite:true });
  };
  const master = ScrollTrigger.create({ start:0, end:"max", onUpdate:drive, onRefresh:drive });
  drive(master);

  gsap.utils.toArray("[data-anim]").forEach((el: any) => {
    if(el.getBoundingClientRect().top < window.innerHeight * .94){ gsap.set(el, { y:0, opacity:1, clearProps:"transform" }); return; }
    gsap.fromTo(el, { y:16, opacity:0 }, { y:0, opacity:1, duration:.7, ease:"power3.out", scrollTrigger:{ trigger:el, start:"top 94%", once:true } });
  });
  gsap.utils.toArray("[data-row]").forEach((el: any) => {
    if(el.getBoundingClientRect().top < window.innerHeight * .94){ gsap.set(el, { clipPath:"inset(0 0% 0 0)", opacity:1 }); return; }
    gsap.fromTo(el, { clipPath:"inset(0 100% 0 0)", opacity:.2 }, { clipPath:"inset(0 0% 0 0)", opacity:1, duration:.75, ease:"power2.out", scrollTrigger:{ trigger:el, start:"top 92%", once:true } });
  });
  const cover = document.querySelector('[data-el="herocard"]');
  if(cover) gsap.fromTo(cover, { y:40 }, { y:-40, ease:"none", scrollTrigger:{ trigger:cover, start:"top bottom", end:"bottom top", scrub:.6 } });
  ScrollTrigger.refresh();
}

mountGrain();
mountCover();
initScroll();
runIntro();
// Absolute safety net: never let the loader trap the page, whatever happens above.
setTimeout(() => { if(!(window as any).__introDone) endIntroNow(); }, 7000);
</script>
</body>
</html>
