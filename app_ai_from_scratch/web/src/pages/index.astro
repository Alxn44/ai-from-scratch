---
export const prerender = false;
import { grafo, org, curso, faq } from '../lib/seo';
import { mercadoDe } from '../lib/region';
import { narrativaDe } from '../lib/narrative';
import { SITE, MARCA } from '../lib/site';
import { ANCLA_VISUAL, PRECIO_VISUAL } from '../lib/price';
import { publicPrefs } from '../lib/prefs';
import { t } from '../lib/i18n';
import { modulos, candidatos, preguntas, micro, ticker } from '../data/landing';
import { jsonSafe } from '../lib/json-safe';
import PrefToggles from '../components/PrefToggles.astro';

// La landing era español fijo: lang="es" a mano, la copia escrita a pelo y sin
// selector de idioma — mientras su propio FAQ prometía que «se cambia de idioma
// desde la barra superior» y el hreflang="en" de más abajo apuntaba a esta misma
// URL en español. Las tres cosas eran la misma falta: no estaba traducida.
const { lang, langPref } = publicPrefs(Astro.request);
const L = t(lang);
const P = L.pub.land;
const canonical = `${SITE}/`;
const desc = P.desc;
// Los dos precios grandes de la pagina eran markup literal, iguales para ES y
// EN. Con USD 9.99 eso pasaba desapercibido porque el punto decimal se escribe
// igual en los dos idiomas; con 35.000 no: en ingles «$35.000» son treinta y
// cinco dolares con tres decimales, no treinta y cinco mil pesos.
const precioBig = PRECIO_VISUAL[lang] ?? PRECIO_VISUAL.es;
const anclaBig = ANCLA_VISUAL[lang] ?? ANCLA_VISUAL.es;
// El FAQ no es relleno de SEO: son las preguntas que llegan por correo, con la
// respuesta exacta. Sirve igual para Google que para un asistente que cite.
const PREGUNTAS = lang === 'en' ? [
  { q: 'Do I need to know how to code to take the course?', a: 'No. Not one line of code, and no maths. The 36 labs are solved by choosing, ordering and assembling inside the lesson.' },
  { q: 'What does it cost and what is included?', a: '35,000 COP a month, cancel anytime. It includes the 12 lessons, the 36 labs, the PDF in Spanish and English, and the Claude Code harness, for as long as the subscription is active.' },
  { q: 'Is there a refund if it is not for me?', a: 'Yes: 14 days from purchase, no explanation needed, back through the same payment method in under 10 business days.' },
  { q: 'Is it available in English?', a: 'Yes. The platform, this page and the lesson content are in Spanish and English, and you switch language from the top bar.' },
  { q: 'What is a token in artificial intelligence?', a: 'A token is the chunk of text the model works with: it sees neither words nor letters, it sees frequent pieces. "Cartagena is beautiful" is three words but five tokens. Everything that gets billed or capped is measured in tokens.' },
  { q: 'Why does AI invent facts that sound true?', a: 'Because it does not always detect that information is missing: it completes the most likely pattern and can present an invented fact with confidence. That is why any fact with consequences gets checked at the source.' },
  { q: 'Does AI learn from what I write to it?', a: 'It is not retrained by each conversation. Training and inference are separate moments: when you talk to it, its parameters do not change. If it seems to remember you, the application may have stored your text and included it in the request again.' },
] : [
  { q: '¿Necesito saber programar para tomar el curso?', a: 'No. No se escribe una línea de código y no hay matemáticas. Los 36 labs se resuelven eligiendo, ordenando y armando dentro de la lección.' },
  { q: '¿Cuánto cuesta y qué incluye?', a: '35.000 COP al mes, y se cancela cuando quieras. Incluye las 12 lecciones, los 36 labs, el PDF en español e inglés y el harness de Claude Code, mientras la suscripción esté activa.' },
  { q: '¿Hay devolución si no me sirve?', a: 'Sí: 14 días desde la compra, sin explicar por qué, por el mismo medio de pago y en menos de 10 días hábiles.' },
  { q: '¿Está disponible en inglés?', a: 'Sí. La plataforma, esta página y el contenido de las lecciones están en español e inglés, y se cambia de idioma desde la barra superior.' },
  { q: '¿Qué es un token en inteligencia artificial?', a: 'Un token es el trozo de texto con el que trabaja el modelo: no ve palabras ni letras, ve pedazos frecuentes. «Cartagena es hermosa» son tres palabras pero cinco tokens. Todo lo que se cobra y se limita se mide en tokens.' },
  { q: '¿Por qué la IA inventa datos que suenan ciertos?', a: 'Porque no siempre detecta que le falta información: completa el patrón más probable y puede presentar un dato inventado con seguridad. Por eso, todo dato con consecuencias se verifica en la fuente.' },
  { q: '¿La IA aprende de lo que le escribo?', a: 'No se reentrena con cada conversación. Entrenamiento e inferencia son momentos separados: cuando le hablas, sus parámetros no cambian. Si parece recordarte, la aplicación puede haber guardado tu texto y volver a incluirlo en el pedido.' },
];
const jsonld = grafo(org(), curso(lang), faq(PREGUNTAS));
// Narrativa según de dónde se conecta, en el idioma de la página.
const { mercado } = mercadoDe(Astro.request);
const N = narrativaDe(mercado, lang);
// El script de la landing es INLINE (usa define:vars para nada, pero corre en el
// navegador), así que no puede importar los datos: llegaban resueltos en build y
// en un solo idioma. Viajan como JSON, que es el patrón que ya usa /pago para el
// texto del tutorial.
const DATOS = {
  modulos: modulos(lang), candidatos: candidatos(lang), faqs: preguntas(lang),
  micro: micro(lang), ticker: ticker(lang),
  txt: { ejemplo: P.aEjemplo, predecible: P.bPredecible,
         equilibrada: P.bEquilibrada, impredecible: P.bImpredecible },
};
---
<!doctype html>
<html lang={lang}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any">
<title>{P.titulo}</title>
<meta name="description" content={desc}>
<link rel="canonical" href={canonical}>
<meta property="og:site_name" content={MARCA}>
<meta property="og:type" content="website">
<meta property="og:title" content={P.titulo}>
<meta property="og:description" content={desc}>
<meta property="og:url" content={canonical}>
<meta property="og:locale" content={lang === 'en' ? 'en_US' : 'es_CO'}>
<meta property="og:locale:alternate" content={lang === 'en' ? 'es_CO' : 'en_US'}>
<meta name="twitter:card" content="summary_large_image">
<!-- Una sola URL que responde en los dos idiomas segun la cookie pref_lang, asi
     que hreflang es correcto solo si la pagina esta REALMENTE traducida. Antes
     declaraba "en" apuntando a una pagina en español: una promesa falsa a Google
     y a cualquier asistente que la cite. -->
<link rel="alternate" hreflang="es" href={canonical}>
<link rel="alternate" hreflang="en" href={canonical}>
<link rel="alternate" hreflang="x-default" href={canonical}>
<script type="application/ld+json" is:inline set:html={jsonld}></script>
<style is:global>
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:#000;-webkit-font-smoothing:antialiased}
a{color:#fff;text-decoration:none}
@keyframes caret{0%,49%{opacity:1}50%,100%{opacity:0}}
@keyframes slide{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}
input[type=range]{-webkit-appearance:none;appearance:none;background:transparent}
input[type=range]::-webkit-slider-runnable-track{height:1px;background:rgba(235,235,245,.34)}
input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:14px;height:26px;margin-top:-13px;border-radius:0;background:#fff;cursor:ew-resize}
input[type=range]::-moz-range-track{height:1px;background:rgba(235,235,245,.34)}
input[type=range]::-moz-range-thumb{width:14px;height:26px;border:0;border-radius:0;background:#fff;cursor:ew-resize}
input[type=text]::placeholder{color:rgba(235,235,245,.26)}
.buy{background:#fff;color:#000;transition:background .2s,color .2s}
.buy:hover{background:var(--ac);color:#fff}
.buyblk{background:#000;color:#fff;transition:background .2s}
.buyblk:hover{background:var(--ac)}
.card-h{transition:background .2s}
.card-h:hover{background:rgba(255,255,255,.03)}
.row-h{transition:background .15s}
.row-h:hover{background:rgba(255,255,255,.04)}
.skip{transition:color .2s;cursor:pointer;min-height:44px;padding:12px 4px 12px 12px;color:rgba(235,235,245,.82)}
/* Los dos tintes del rig de aberracion cromatica del loader (index.astro, el
   bloque [data-el="intrologo"]). Van ENMASCARADOS al glifo, y eso no es
   cosmetico: mix-blend-mode:multiply sobre un fondo TRANSPARENTE composita el
   color a plena fuerza, asi que sin mascara cada tinte pinta el cuadro entero
   de 186x186 y screen(#FF453A,#0A84FF) = rgb(255,164,255). De ahi salia el
   cuadrado rosado. mask-size:contain para cuadrar con el object-fit:contain
   de la img hermana. */
/* LA MARCA ES «IA» EN UN CUADRO, y se dibuja.
   Antes era <img src="/logo.png"> en seis sitios, y el rig de aberracion
   cromatica del loader tenia que enmascarar dos tintes contra el glifo de esa
   imagen para no pintar el cuadro entero de color. Con la marca dibujada ese
   problema no existe: cada capa hereda su color y no hace falta mascara, ni
   mix-blend-mode:multiply, ni cargar un PNG antes de poder animar.
   El tamano entra por --lg para que los cuatro usos (186, 24, 22 y 18 px)
   compartan proporciones en vez de repetir numeros sueltos. */
.deslizador{height:26px}
@media (max-width:900px){.deslizador{height:44px}}
.lg{display:grid;place-items:center;flex:none;box-sizing:border-box;
  width:var(--lg,24px);height:var(--lg,24px);color:inherit;
  border:max(1px,calc(var(--lg,24px) * .04)) solid currentColor;
  font:700 calc(var(--lg,24px) * .46)/1 var(--f);letter-spacing:-.02em}
/* Las dos capas desplazadas del rig: centran su cuadro y le dan el color. */
[data-split]{display:grid;place-items:center}
.skip:hover{color:#fff!important}
section[id]{scroll-margin-top:72px}
.hero-grid{display:grid;grid-template-columns:1fr 372px;gap:44px;align-items:end}
.hero-split{display:grid;grid-template-columns:1fr 1fr;gap:0}
.sintomas{display:grid;grid-template-columns:repeat(3,1fr)}
.especimenes{display:grid;grid-template-columns:1fr 1fr}
.precio-grid{display:grid;grid-template-columns:1.2fr .8fr}
.why-row{display:grid;grid-template-columns:52px 300px 1fr;gap:24px}
.foot-meta{display:grid;grid-template-columns:repeat(4,1fr);gap:24px}
@media (max-width:900px){
  .lnav-meta,.lnav-pct,.lnav-aux,.sticky-copy,.sticky-rule{display:none!important}
  .hero-grid,.hero-split,.sintomas,.especimenes,.precio-grid,.foot-meta{grid-template-columns:1fr!important}
  .hero-grid{gap:28px!important}
  .hero-split > div:first-child{border-right:0!important;padding:16px 0 8px!important}
  .hero-split > div:last-child{padding:8px 0 16px!important}
  .idx-head{display:none!important}
  [data-row]{grid-template-columns:1fr!important;gap:8px!important}
  .why-row{grid-template-columns:52px 1fr!important}
  .why-row > :nth-child(3){grid-column:2}
  .precio-grid > div{padding:28px 22px!important;border-right:0!important}
  .tokin{font-size:16px!important}
  /* El <br> del h1 esta escrito a mano: en escritorio parte la frase donde se
     quiere, en movil la bloquea. Se desactiva y text-wrap:balance decide. */
  /* El <br> se oculta, pero delante lleva un espacio de verdad en el marcado:
     sin el, las dos mitades se pegaban y el titular decia «Entiende la IAen una
     tarde.» / «Understand AIin one afternoon.». En escritorio ese espacio queda
     al final de la primera linea, donde no se ve. */
  .hero-h1 br{display:none}
  /* 150px arriba para una nav de 56. */
  .hero-sec{padding-top:104px!important}
  /* La portada dice 1080x1350 en su propia etiqueta pero medía 465px fijos.
     A 342 de ancho un 4:5 son 427. */
  [data-el="herocard"]{height:auto!important;aspect-ratio:4/5}
}
/* La nav a DOS filas solo donde no cabe en una. Medido: el contenido pide
   ~375 px (marca 142 + ENTRAR 47 + gap 22 + COMPRAR 144 + gap 20) y el
   contenedor da W-32, asi que una fila aguanta a partir de ~430 px. A 520 hay
   margen de sobra. Por encima de eso, forzar dos filas gastaba 74 px de nav
   fija sin motivo: medido en 820 px daba 131 px de alto. */
@media (max-width:520px){
  .lnav-in{flex-wrap:wrap;height:auto!important;padding:0 16px 10px!important;row-gap:10px}
  .lnav-in > div:first-child{width:100%;height:56px}
  .lnav-in > div:last-child{width:100%;gap:14px!important}
  .lnav-buy{flex:1;justify-content:center}
  .hero-sec{padding-top:176px!important}
}
.tokin:focus{border-color:#fff!important}
.navlink:hover{color:#fff!important}

/* EL SELECTOR DE IDIOMA DE LA NAV.
   Estaba SIN ESTILO. `.seg` y `.segb` se declaran en PUBLIC_BASE
   (lib/theme-css.ts) y otra vez en layouts/App.astro, y esta pagina no usa
   ninguno de los dos layouts -- importa el componente y nada mas. El navegador
   pintaba tres botones nativos: Arial 13,3px negra, fondo #efefef, borde
   `2px outset #000` y 21,5px de alto, sobre el fondo negro de la landing.
   Medido en produccion, no deducido.

   No se importa PUBLIC_BASE para arreglarlo. Sus reglas pintan el estado activo
   con `background:var(--ac-solid)` y el hover con `var(--fill)`, y el contenedor
   de esta pagina (mas abajo, el div que declara --f/--m/--l1/...) no define
   ninguno de los dos: el boton activo se quedaria sin fondo. Ademas ese control
   segmentado, con su relleno azul solido, pesaria mas que el propio CTA de
   compra, que es blanco. Un selector de idioma no puede gritar mas que COMPRAR.

   Asi que aqui habla el idioma de la nav: el mismo 10px/.18em monoespaciado de
   .navlink, que esta a 20px de distancia. La jerarquia la hacen el peso y el
   color, no una caja. 44px de alto tactil aunque el texto mida 10: la landing no
   carga el suelo de 44 de PUBLIC_BASE, asi que sin esto el objetivo tactil se
   queda en los 21,5px medidos arriba.

   Y 44px de ANCHO, que es la otra mitad del mismo suelo. Con `padding:0 7px`
   los botones median 44 de alto y 30 de ancho: un objetivo tactil no es una
   altura, es un area, y 30 de ancho se sigue fallando con el pulgar. Con 14px
   miden [59, 44, 44]. Medido en produccion contra la nav real a 390, 480, 520,
   560, 640, 768 y 900px: `scrollWidth == innerWidth` en los siete, y la barra
   conserva sus dos filas por debajo de 560 y una sola por encima. No lleva
   media query justamente por eso -- no habia ancho donde estorbara. */
.lnav-lang .seg{display:flex;align-items:center;gap:2px;border:0}
.lnav-lang .segb{
  display:inline-flex;align-items:center;min-height:44px;padding:0 14px;
  background:none;border:0;cursor:pointer;
  font:500 10px/1 var(--m);letter-spacing:.18em;text-transform:uppercase;
  color:var(--l3);transition:color .15s
}
.lnav-lang .segb:hover{color:var(--l2)}
.lnav-lang .segb[aria-pressed="true"]{color:var(--l1);font-weight:600}
.lnav-lang .segb:focus-visible{outline:1px solid var(--l1);outline-offset:2px}
/* Los enlaces de la barra medían 10px de ALTO: son destinos de navegacion, no
   texto dentro de una frase, y con el pulgar no se aciertan. En escritorio el
   raton apunta fino y la barra es de 56px, asi que el suelo solo entra en el
   ancho donde se toca. */
@media (max-width:900px){
  .navlink{display:inline-flex;align-items:center;min-height:44px}
}
@media print{
  @page{size:Letter;margin:.42in}
  html,body{background:#fff!important}
  body>div>div[style*="position:fixed"]{display:none!important}
  body>div{background:#fff!important;color:#14283d!important;overflow:visible!important}
  body>div *{color:#14283d!important;text-shadow:none!important}
  body>div [style*="var(--l2)"]{color:#4b5966!important}
  body>div [style*="var(--l3)"]{color:#6b7784!important}
  body>div [style*="var(--ac)"]{color:#0a70d1!important}
  body>div [style*="background:#000"]{background:#fff!important}
  body>div [style*="background:#F2F2F2"]{background:#f2f5f8!important}
  .buy,.buyblk{background:#0a70d1!important;color:#fff!important}
  [data-el="herocard"]{background:#eef4fb!important}
  canvas[data-fx]{display:none!important}
  section{break-inside:avoid}
  [data-row], [data-anim]{opacity:1!important;transform:none!important;clip-path:none!important}
}
</style>
</head>
<body>

<div style="--f:-apple-system,'SF Pro Display','SF Pro Text','Helvetica Neue',system-ui,sans-serif;--m:ui-monospace,'SF Mono',SFMono-Regular,Menlo,monospace;--l1:#fff;--l2:rgba(235,235,245,.62);--l3:rgba(235,235,245,.50);--hair:rgba(84,84,88,.42);--hair2:rgba(84,84,88,.22);--ac:#0A84FF;background:#000;font-family:var(--f);color:var(--l1);overflow-x:hidden;position:relative">

<!-- ===== LOADER ===== -->
<div data-el="intro" style="position:fixed;inset:0;z-index:200;background:#000;display:flex;align-items:center;justify-content:center;overflow:hidden">
  <div data-el="introgrid" id="introgrid" style="position:absolute;inset:0;padding:22px;display:grid;grid-template-columns:repeat(12,1fr);grid-auto-rows:1fr;gap:1px;will-change:transform"></div>
  <div style="position:absolute;inset:0;background:radial-gradient(ellipse at 50% 50%,rgba(0,0,0,.10) 0%,rgba(0,0,0,.72) 62%,#000 100%);pointer-events:none"></div>
  <div style="position:relative;z-index:3;display:flex;flex-direction:column;align-items:center;gap:26px">
    <div data-el="intrologo" style="position:relative;isolation:isolate;width:186px;height:186px;opacity:0;will-change:transform,filter">
      <div data-split="r" style="position:absolute;inset:0;mix-blend-mode:screen;color:#FF453A">
        <span class="lg" style="--lg:186px" aria-hidden="true">IA</span>
      </div>
      <div data-split="b" style="position:absolute;inset:0;mix-blend-mode:screen;color:#0A84FF">
        <span class="lg" style="--lg:186px" aria-hidden="true">IA</span>
      </div>
      <div style="position:absolute;inset:0;display:grid;place-items:center;color:#fff;mix-blend-mode:screen">
        <span class="lg" style="--lg:186px" role="img" aria-label="IA desde cero">IA</span>
      </div>
    </div>
    <div data-el="introword" style="display:flex;flex-direction:column;align-items:center;gap:10px;clip-path:inset(0 100% 0 0)">
      <div style="font:700 44px/1 var(--f);letter-spacing:-.04em;color:#fff">{P.figMarca}</div>
      <div style="font:600 11px/1 var(--m);letter-spacing:.34em;color:rgba(235,235,245,.45)">{P.figVol}</div>
    </div>
  </div>
  <div id="skip" class="skip" role="button" tabindex="0" style="position:absolute;right:26px;bottom:24px;z-index:4;display:flex;align-items:center;gap:9px;font:600 11px/1 var(--m);letter-spacing:.20em">
    <span>{P.saltar}</span>
    <svg width="16" height="16" viewBox="0 0 20 20"><path d="M4 10h11M11 5.5l4.5 4.5L11 14.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
  </div>
</div>

<canvas data-fx="grain" style="position:fixed;inset:0;width:100%;height:100%;z-index:90;pointer-events:none;opacity:.055"></canvas>

<div style="position:fixed;left:0;right:0;top:0;bottom:0;z-index:1;pointer-events:none;display:flex;justify-content:center">
  <div style="width:100%;max-width:1240px;height:100%;background-image:repeating-linear-gradient(to right,var(--hair2) 0 1px,transparent 1px calc(100% / 6))"></div>
</div>

<div style="position:fixed;left:0;right:0;top:0;z-index:70;height:1px;background:var(--hair)">
  <div data-el="bar" style="height:100%;width:100%;background:#fff;transform-origin:left;transform:scaleX(0)"></div>
</div>

<!-- ===== NAV ===== -->
<div style="position:fixed;left:0;right:0;top:1px;z-index:60;background:rgba(0,0,0,.86);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);border-bottom:1px solid var(--hair);padding-top:env(safe-area-inset-top)">
  <div class="lnav-in" style="max-width:1240px;margin:0 auto;padding:0 24px;height:56px;display:flex;align-items:center;justify-content:space-between;gap:20px">
    <div style="display:flex;align-items:center;gap:14px">
      <span class="lg" style="--lg:24px" role="img" aria-label={P.figMarca}>IA</span>
      <div style="font:700 15px/1 var(--f);letter-spacing:-.01em">{P.figMarca}</div>
      <div class="lnav-meta" style="width:1px;height:16px;background:var(--hair)"></div>
      <div class="lnav-meta" style="font:500 10px/1 var(--m);letter-spacing:.18em;color:var(--l3)">{P.figVol}</div>
      <!-- El selector va en el grupo de la MARCA, no en el de las acciones. Ese
           grupo pide ya ~375px medidos (marca 142 + ENTRAR 47 + gaps + CTA 144) y
           por debajo de 520 la nav parte en dos filas, cada una de ancho completo:
           aqui el toggle cabe, en el otro lado desbordaba.
           Y va soloIdioma: la landing tiene fondo negro fijo, sin tokens de tema,
           asi que un boton PAPEL no cambiaria nada — que es exactamente el tipo de
           boton que hay que quitar, no añadir. -->
      <div class="lnav-lang" style="display:flex;align-items:center">
        <PrefToggles lang={langPref} soloIdioma labels={{ auto: L.pub.auto, langAria: L.pub.ariaIdioma }} />
      </div>
    </div>
    <div style="display:flex;align-items:center;gap:22px">
      <div class="lnav-pct" data-el="pct" style="font:500 10px/1 var(--m);letter-spacing:.14em;color:var(--l3);font-variant-numeric:tabular-nums">000%</div>
      <a href="#indice" class="navlink lnav-aux" style="font:500 10px/1 var(--m);letter-spacing:.18em;color:var(--l2)">{P.navIndice}</a>
      <a href="#especimenes" class="navlink lnav-aux" style="font:500 10px/1 var(--m);letter-spacing:.18em;color:var(--l2)">{P.navEspec}</a>
      <a href="/login" class="navlink" style="font:500 10px/1 var(--m);letter-spacing:.18em;color:var(--l2);text-decoration:none">{P.navEntrar}</a>
      <a href="/pago" class="buy lnav-buy" style="display:flex;align-items:center;justify-content:center;gap:8px;font:600 10px/1 var(--m);letter-spacing:.16em;min-height:44px;padding:0 15px;white-space:nowrap">
        <span>{P.navCta}</span>
      </a>
    </div>
  </div>
</div>

<!-- ===== HERO ===== -->
<section class="hero-sec" style="position:relative;z-index:2;max-width:1240px;margin:0 auto;padding:150px 24px 0">
  <div class="hero-grid" style="border-bottom:1px solid var(--hair);padding-bottom:34px">
