  <div id="faqs" style="border-top:1px solid var(--hair)"></div>
</section>

<!-- ===== FINAL CTA ===== -->
<section style="position:relative;z-index:2;max-width:1240px;margin:0 auto;padding:100px 24px 130px">
  <div data-anim="1" style="display:flex;flex-direction:column;gap:30px;border-top:1px solid var(--hair);padding-top:40px">
    <div style="font:700 clamp(34px,5.4vw,80px)/.96 var(--f);letter-spacing:-.05em;max-width:900px;text-wrap:balance">{P.cierreH2}</div>
