---
export const prerender = false;
import Public from '../layouts/Public.astro';
import { t } from '../lib/i18n';
import { publicPrefs } from '../lib/prefs';
import { grafo, org } from '../lib/seo';
import { icon } from '../lib/icons';

const { lang } = publicPrefs(Astro.request);
const L = t(lang);
const jsonld = grafo(org());
const P = L.pub.sop;
const CORREO = L.pub.footer.correo;
const asunto = lang === 'en' ? 'Support · AI from scratch' : 'Soporte · IA desde cero';
---
<Public title={P.eb} desc={P.pitch} jsonld={jsonld} ancho={900}>
  <div style="display:flex;flex-direction:column;gap:14px">
    <p class="eb">{P.eb}</p>
    <h1 class="h1" style="font-size:40px">{P.h1a} <span style="color:var(--l3)">{P.h1b}</span></h1>
    <p class="p" style="max-width:600px;margin-top:6px">{P.pitch}</p>
  </div>

  <div class="card" style="margin-top:32px;border-left:2px solid var(--ac);display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:20px">
    <div style="display:flex;flex-direction:column;gap:8px">
      <p class="lbl">{P.correoLbl}</p>
      <span id="mail" class="num" style="font:600 20px/1 var(--m)">{CORREO}</span>
      <p class="s">{P.respLbl}: {P.respV}</p>
    </div>
    <div style="display:flex;gap:10px;flex-wrap:wrap">
      <button class="btn ghost" id="copiar">{P.copiar}</button>
      <a class="btn" href={`mailto:${CORREO}?subject=${encodeURIComponent(asunto)}`} style="text-decoration:none">{P.abrir}</a>
    </div>
  </div>

  <div class="soporte-2" style="margin-top:34px">
    <div class="card" style="display:flex;flex-direction:column;gap:12px">
      <p class="lbl">{P.temas}</p>
      {[P.t1, P.t2, P.t3, P.t4, P.t5].map((x) => (
        <div style="display:flex;gap:10px;align-items:flex-start">
          <Fragment set:html={icon('check', 16, 'var(--ok)')} />
          <p class="p" style="font-size:14px">{x}</p>
        </div>
      ))}
    </div>
    <div style="display:flex;flex-direction:column;gap:22px">
      <div class="card" style="display:flex;flex-direction:column;gap:12px">
        <p class="lbl">{P.antes}</p>
        {[P.a1, P.a2, P.a3].map((x, i) => (
          <div style="display:flex;gap:10px;align-items:flex-start">
            <span class="num lbl" style="color:var(--l3);padding-top:2px">{i + 1}</span>
            <p class="p" style="font-size:14px">{x}</p>
          </div>
        ))}
      </div>
      <div class="card" style="display:flex;flex-direction:column;gap:10px">
        <p class="lbl">{P.estado}</p>
        <div style="display:flex;align-items:center;gap:9px">
          <span style="width:8px;height:8px;border-radius:5px;background:var(--ok)"></span>
          <span class="h3" style="color:var(--ok)">{P.ok}</span>
        </div>
        <p class="s" style="color:var(--l2)">{P.estadoB}</p>
      </div>
    </div>
  </div>

  <script define:vars={{ P, CORREO }}>
    document.getElementById('copiar').addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(CORREO); window.toast('ok', P.tCopia, P.tCopiaB); }
      catch { const r = document.createRange(); r.selectNode(document.getElementById('mail')); getSelection().removeAllRanges(); getSelection().addRange(r); }
    });
  </script>
</Public>
