---
export const prerender = false;
import App from '../layouts/App.astro';
import { gate, apiFetch } from '../lib/session';
import { t, resolveLang } from '../lib/i18n';
import { jsonSafe } from '../lib/json-safe';
import { trofeo, estrella, RANGO_METAL, RANGO_FORMA } from '../lib/badges';

const { user, redirect } = await gate(Astro.request);
if (redirect) return Astro.redirect(redirect);

type Logro = { code: string; kind: string; lesson_n: number | null; earned_at: string };
type Fila = { n: number; total: number; solved: number };
const data = await apiFetch<{ logros: Logro[]; nivel: number; total: number; perLesson: Fila[] }>('/api/logros', Astro.request);
const lang = resolveLang(user!.lang, Astro.request);
const L = t(lang);
const G = L.logros;

const logros = data?.logros ?? [];
const nivel = data?.nivel ?? 0;
const perLesson = data?.perLesson ?? [];
const ganados = new Set(logros.map((l) => l.code));
const GRADOS = ['aprendiz', 'oficiante', 'maestro'] as const;
const codigoLeccion = (n: number, g: string) => `l${String(n).padStart(2, '0')}.${g}`;
const cerradas = perLesson.filter((r) => r.total > 0 && r.solved === r.total).length;
const faltan = Math.max(0, nivel + 1 - cerradas) || 1;
const rangoTxt = (i: number) => G.rangos[i - 1] ?? '';
// Trazo del camino: el mismo que usa el roadmap animado, para que se lean igual.
const px = (n: number) => 40 + ((n - 1) * 920) / 11;
const py = (n: number) => 95 + Math.sin(n * 0.9) * 42;
const camino = Array.from({ length: 12 }, (_, i) => i + 1)
  .map((n) => `${n === 1 ? 'M' : 'L'}${px(n).toFixed(1)},${py(n).toFixed(1)}`).join(' ');
---
<App user={user!} title={G.titulo} crumb={G.crumb} active={L.nav.logros}>
  <a slot="topbar" class="btn ghost" style="height:36px;font-size:10px;text-decoration:none" href="/ranking">{L.rank.titulo}</a>

  <div style="padding:30px 28px 48px;display:flex;flex-direction:column;gap:26px;max-width:1180px">

    <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:24px;flex-wrap:wrap">
      <div style="display:flex;flex-direction:column;gap:12px">
        <h1 class="h1">{G.titulo}</h1>
        <p class="p" style="max-width:620px">{G.pitch}</p>
      </div>
      <div class="card" style="width:330px;border-left:2px solid var(--ac);display:flex;gap:18px;align-items:flex-start">
        <div style={`flex:none;width:80px;display:grid;place-items:center;padding-top:2px;${nivel ? '' : 'opacity:.22;filter:grayscale(1)'}`}>
          <Fragment set:html={trofeo(nivel ? RANGO_FORMA(nivel) : 'copa', nivel ? RANGO_METAL(nivel) : 'plata', 'rango-hoy', 96)} />
        </div>
        <div style="display:flex;flex-direction:column;gap:8px;min-width:0;flex:1">
        <p class="lbl">{G.rangoActual}</p>
        <div class="h1" style="font-size:26px">{nivel ? rangoTxt(nivel) : G.sinRango}</div>
        {nivel < 12 && (
          <p class="s" style="color:var(--l2)">{G.siguiente}: <b style="color:var(--l1);font-weight:600">{rangoTxt(nivel + 1)}</b> · {G.faltan.replace('{n}', String(faltan))}</p>
        )}
        <button id="ver" class="btn ghost" style="margin-top:8px" disabled={!nivel}>{G.verRoadmap}</button>
        </div>
      </div>
    </div>

    <div class="card" style="border-color:var(--hair);padding:18px 22px 10px">
      <svg viewBox="0 0 1000 190" style="width:100%;height:auto;overflow:visible">
        <path d={camino} fill="none" stroke="var(--hair)" stroke-width="2" stroke-dasharray="5 7"></path>
        {nivel > 1 && (
          <path d={Array.from({ length: nivel }, (_, i) => i + 1).map((n) => `${n === 1 ? 'M' : 'L'}${px(n).toFixed(1)},${py(n).toFixed(1)}`).join(' ')}
            fill="none" stroke="var(--ac)" stroke-width="2.5"></path>
        )}
        {Array.from({ length: 12 }, (_, i) => i + 1).map((n) => (
          <g opacity={n <= nivel ? 1 : 0.32}>
            {n <= nivel
              ? <g transform={`translate(${(px(n) - (n === nivel ? 13 : 10)).toFixed(1)},${(py(n) - (n === nivel ? 16 : 12)).toFixed(1)})`}>
                  <Fragment set:html={trofeo(RANGO_FORMA(n), RANGO_METAL(n), `nodo-${n}`, n === nivel ? 32 : 24)} />
                </g>
              : <circle cx={px(n)} cy={py(n)} r="7" fill="var(--bg)" stroke="var(--hair)" stroke-width="2"></circle>}
            <text x={px(n)} y={py(n) + 26} text-anchor="middle" style="font:600 10px/1 var(--m);fill:var(--l3)">{n}</text>
            <text x={px(n)} y={py(n) - 22} text-anchor="middle" style="font:500 9px/1 var(--m);letter-spacing:.1em;text-transform:uppercase;fill:var(--l3)">{rangoTxt(n).split(' ')[0]}</text>
          </g>
        ))}
      </svg>
    </div>

    <div style="display:flex;align-items:baseline;gap:14px;border-bottom:1px solid var(--hair);padding-bottom:14px">
      <p class="lbl">{G.porLeccion}</p>
      <span class="s num">{logros.length} {G.deLos} 48</span>
    </div>

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(300px,100%),1fr));gap:16px">
      {perLesson.map((r) => (
        <div class="card" style="display:flex;flex-direction:column;gap:12px;border-color:var(--hair2)">
          <div style="display:flex;align-items:baseline;justify-content:space-between;gap:12px">
            <span class="num lbl">{String(r.n).padStart(2, '0')}</span>
            <span class="num s">{r.solved} / {r.total}</span>
          </div>
          <div style="display:flex;flex-direction:column;gap:8px">
            {GRADOS.map((g, i) => {
              const tiene = ganados.has(codigoLeccion(r.n, g));
              return (
                <div style="display:flex;align-items:center;gap:10px">
                  <span style="width:22px;height:22px;flex:none;display:grid;place-items:center">
                    <Fragment set:html={estrella(tiene, `e-${r.n}-${g}`, 22)} />
                  </span>
                  <span style={`font:600 13px/1 var(--f);color:${tiene ? 'var(--l1)' : 'var(--l3)'}`}>{G.grados[g]}</span>
                  <span class="s" style="margin-left:auto">{G.gradoAyuda[g]}</span>
                </div>
              );
            })}
          </div>
        </div>
      ))}
    </div>

    {logros.length === 0 && (
      <div class="card" style="border-style:dashed;display:flex;flex-direction:column;gap:6px">
        <div class="h3">{G.vacio}</div>
        <p class="s" style="color:var(--l2)">{G.vacioB}</p>
      </div>
    )}
  </div>

  <script type="application/json" id="rm-txt" is:inline set:html={jsonSafe({
    nivel, eb: G.eb, titulo: G.titulo, sub: G.sub, cerrar: G.cerrar, seguir: G.seguir,
    rangos: G.rangos, paradaN: G.parada,
  })}></script>

  <script>
    // Script de módulo (no define:vars): así el bundler resuelve gsap y roadmap.ts.
    import { gsap } from 'gsap';
    import { abrirRoadmap } from '../lib/roadmap';
    (window as any).gsap = gsap;
    const T = JSON.parse(document.getElementById('rm-txt')!.textContent!);
    document.getElementById('ver')?.addEventListener('click', () => abrirRoadmap(T.nivel, T));
  </script>
</App>
