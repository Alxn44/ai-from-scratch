---
export const prerender = false;
import App from '../layouts/App.astro';
import { gate, apiFetch } from '../lib/session';
import { icon } from '../lib/icons';
import { t, resolveLang } from '../lib/i18n';

const { user, redirect } = await gate(Astro.request);
if (redirect) return Astro.redirect(redirect);

type Lab = { id: string; idx: number; level: string; kind: string; draft: boolean; solved: boolean };
type Lesson = { n: number; eyebrow: string; title: string; summary: string; math: string; math_cap: string; labs: Lab[]; solved: number; total: number };
const data = await apiFetch<{ lessons: Lesson[] }>('/api/lessons', Astro.request);
const prog = await apiFetch<{ solvedLabs: number; totalLabs: number; lessonsDone: number; totalLessons: number }>('/api/progress', Astro.request);
// El ascenso de liga se pide AQUI, no solo en /ligas: si solo se anuncia en la
// pagina de ligas, quien no entra nunca no se entera de que subio. La llamada va
// con `?? null` porque un fallo de ligas no puede tumbar el panel.
type Subida = { de: string; a: string; semana: string };
const liga = await apiFetch<{ yo: { subida: Subida | null } | null; semana: { lunes: string } | null }>(
  '/api/ligas', Astro.request).catch(() => null);
const subida = liga?.yo?.subida ?? null;
const lang = resolveLang(user!.lang, Astro.request);
const L = t(lang);
const rolTxt = user!.role === 'tutor' ? L.ui.rolTutor : user!.role === 'admin' ? L.ui.rolAdmin : L.ui.rolStudent;
const lessons = data?.lessons ?? [];
// «Continuar» debe llevar a algo que se pueda resolver: la primera lección con
// un lab escrito y sin resolver. Si no hay, la primera con contenido escrito.
const playable = (l: Lesson) => l.labs.some((x) => !x.draft && !x.solved);
const next = lessons.find(playable) ?? lessons.find((l) => l.labs.some((x) => !x.draft)) ?? lessons[0];
const pct = prog ? Math.round((prog.lessonsDone / prog.totalLessons) * 100) : 0;
const labPct = prog ? Math.round((prog.solvedLabs / prog.totalLabs) * 100) : 0;
const STATE = (l: Lesson) => {
  const escritos = l.labs.filter((x) => !x.draft);
  if (!escritos.length) return [L.ui.estBorrador, 'var(--or)', 'rgba(255,159,10,.12)'];
  if (l.solved === l.total) return [L.ui.estHecha, 'var(--ok)', 'rgba(48,209,88,.14)'];
  if (l.solved > 0) return [L.ui.estCurso, 'var(--ac)', 'rgba(10,132,255,.16)'];
  return [L.ui.estPend, 'var(--l3)', 'transparent'];
};
---
<App user={user!} title={L.nav.panel} crumb={`${L.nav.panel.toUpperCase()} / ${rolTxt.toUpperCase()}`} active={L.nav.panel}>
  <a slot="topbar" class="btn" style="height:36px;font-size:10px;text-decoration:none" href={`/leccion/${next?.n ?? 1}`}>{L.continuar}</a>

  <div style="padding:30px 28px 40px;display:flex;flex-direction:column;gap:26px">

    <div style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px">
      <div class="card" style="grid-column:span 2;display:flex;flex-direction:column;gap:18px;border-color:var(--hair)">
        <div style="display:flex;align-items:baseline;justify-content:space-between;gap:16px">
          <p class="eb">{String(next?.n).padStart(2, '0')} · {next?.eyebrow} · {L.ui.sigueAqui}</p>
          <p class="lbl num">{next?.solved} / {next?.total} {L.ui.labsTag}</p>
        </div>
        <h1 class="h1" style="font-size:30px">{next?.title}</h1>
        <p class="p" style="max-width:560px">{next?.summary}</p>
        <div style="display:flex;gap:10px;flex-wrap:wrap">
          {next?.labs.map((l) => (
            <span class="chip" data-on={l.solved ? '' : undefined} style="min-height:38px;font-size:12px">
              LAB {l.id} · {l.level.toUpperCase()}{l.draft ? ` · ${L.ui.borradorTag}` : ''}
            </span>
          ))}
        </div>
        <div style="display:flex;gap:12px;margin-top:4px">
          <a class="btn" style="text-decoration:none" href={`/leccion/${next?.n}`}><Fragment set:html={icon('play', 16, '#000')} /><span>{L.continuarLeccion}</span></a>
        </div>
      </div>

      <div style="display:flex;flex-direction:column;gap:22px">
        <div class="card" style="display:flex;flex-direction:column;gap:14px">
          <p class="lbl">{L.progreso}</p>
          <div style="display:flex;align-items:baseline;gap:8px">
            <span class="num" style="font:700 40px/1 var(--f);letter-spacing:-.04em">{prog?.lessonsDone}</span>
            <span class="num" style="font:500 15px/1 var(--m);color:var(--l3)">/ {prog?.totalLessons} {L.lecciones}</span>
          </div>
          <div class="bar"><div class="barfill" style={`width:${pct}%`}></div></div>
          <div style="display:flex;justify-content:space-between">
            <span class="s">{prog?.solvedLabs} / {prog?.totalLabs} {L.labsResueltos}</span>
            <span class="s num" style="color:var(--l2)">{labPct}%</span>
          </div>
        </div>
        <div class="card" style="display:flex;flex-direction:column;gap:12px">
          <p class="lbl">{L.material}</p>
          <p class="s" style="color:var(--l2)">{L.ui.matPdf}</p>
          <button class="btn ghost" id="pdf" style="justify-content:flex-start"><Fragment set:html={icon('pdf', 16)} /><span>{L.descargarPdf}</span></button>
        </div>
      </div>
    </div>

    <div style="display:flex;flex-direction:column;gap:14px">
      <div style="display:grid;grid-template-columns:46px 1fr 190px 92px 104px;gap:18px;padding:0 4px 10px;border-bottom:1px solid var(--hair)">
        <div class="tblhead">#</div><div class="tblhead">{L.ui.leccionCol}</div><div class="tblhead">{L.nav.labs}</div><div class="tblhead">{L.ui.hechosCol}</div><div class="tblhead">{L.ui.estadoCol}</div>
      </div>
      {lessons.map((l) => {
        const [txt, col, bg] = STATE(l);
        return (
          <a href={`/leccion/${l.n}`} style="display:grid;grid-template-columns:46px 1fr 190px 92px 104px;gap:18px;align-items:center;height:52px;padding:0 4px;border-bottom:1px solid var(--hair2);color:var(--l1)">
            <span class="num" style="font:600 13px/1 var(--m);color:var(--l3)">{String(l.n).padStart(2, '0')}</span>
            <span style="display:flex;flex-direction:column;gap:5px;min-width:0">
              <span class="lbl" style="color:var(--ac);letter-spacing:.16em">{l.eyebrow}</span>
              <span style="font:600 14px/1.2 var(--f);letter-spacing:-.01em">{l.title}</span>
            </span>
            <span class="s" style="color:var(--l2)">{l.labs.map((x) => `Lab ${x.id}`).join(' · ')}</span>
            <span class="num" style="font:500 13px/1 var(--m);color:var(--l2)">{l.solved} / {l.total}</span>
            <span style={`justify-self:start;display:inline-flex;align-items:center;height:26px;padding:0 10px;border:1px solid ${col};background:${bg};font:500 10px/1 var(--m);letter-spacing:.12em;text-transform:uppercase;color:${col}`}>{txt}</span>
          </a>
        );
      })}
    </div>
  </div>

  <script type="application/json" id="ui-txt" is:inline set:html={JSON.stringify({ ...L.ui, lang })}></script>
  {subida && (
    <script type="application/json" id="subida-txt" is:inline set:html={JSON.stringify({
      de: subida.de, a: subida.a, semana: liga?.semana?.lunes ?? subida.semana,
      eb: L.logros.db.liga, titulo: L.ligas.subiste,
      cuerpo: L.ligas.subisteB.replace('{de}', L.ligas[subida.de as 'bronce']).replace('{a}', L.ligas[subida.a as 'bronce']),
      puesto: L.ligas.puesto,
    })}></script>
  )}

  <script>
    import { desbloquear } from '../lib/desbloqueo';
    import { sonar, prepararSonido } from '../lib/sonido';
    const U = JSON.parse(document.getElementById('ui-txt')!.textContent!);

    // Una vez por semana y por navegador. La MISMA clave que usa /ligas, para
    // que subir se anuncie una sola vez y no una por pagina.
    const sb = document.getElementById('subida-txt');
    if (sb) {
      const d = JSON.parse(sb.textContent!);
      const k = `curso.liga.sub.${d.semana}`;
      if (!localStorage.getItem(k)) {
        localStorage.setItem(k, '1');
        prepararSonido();
        desbloquear({
          tipo: 'liga', metal: d.a, titulo: d.titulo, cuerpo: d.cuerpo,
          accion: { txt: U.nav?.ligas ?? 'Ligas', fn: () => { location.href = '/ligas'; } },
        }, d.eb);
        // El sonido necesita un gesto previo del usuario en el documento. Si el
        // navegador lo bloquea, el aviso visual ya cumplio: no se reintenta.
        sonar('liga', 6);
      }
    }

    document.getElementById('pdf')?.addEventListener('click', async () => {
      const res = await fetch(`/api/pdf/${U.lang}`);
      if (res.ok) {
        const url = URL.createObjectURL(await res.blob());
        const a = document.createElement('a');
        a.href = url; a.download = `ia-desde-cero-${U.lang}.pdf`; a.click();
        URL.revokeObjectURL(url);
        window.toast('info', U.pdfListo, U.pdfListoB);
        return;
      }
      const err = await res.json().catch(() => ({}));
      if (res.status === 402) window.toast('warn', U.pdfSinCompra, U.pdfSinCompraB);
      else window.toast('bad', U.pdfNoGenerado, err.msg ?? U.pdfNoGeneradoB);
    });
  </script>
</App>
