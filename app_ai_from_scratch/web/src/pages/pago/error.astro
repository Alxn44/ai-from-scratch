---
export const prerender = false;
import Public from '../../layouts/Public.astro';
import { t } from '../../lib/i18n';
import { publicPrefs } from '../../lib/prefs';
import { icon } from '../../lib/icons';

const { lang } = publicPrefs(Astro.request);
const L = t(lang);
const P = L.pub.errp;
const q = new URL(Astro.request.url).searchParams;
const ref = q.get('payment_id') ?? q.get('collection_id') ?? q.get('preference_id') ?? '';
---
<Public title={P.eb} noindex ancho={860}>
  <div style="display:flex;flex-direction:column;gap:16px">
    <p class="eb" style="color:var(--rd)">{P.eb}</p>
    <h1 class="h1" style="font-size:42px">{P.h1a} <span style="color:var(--l3)">{P.h1b}</span></h1>
    <p class="p" style="max-width:560px">{P.pitch}</p>
  </div>

  <div class="card" style="margin-top:26px;border-left:2px solid var(--rd);display:flex;gap:14px;align-items:flex-start">
    <Fragment set:html={icon('info', 20, 'var(--rd)')} />
    <div style="flex:1;display:flex;flex-direction:column;gap:5px">
      <div class="h3" style="color:var(--rd)">{P.nada}</div>
      <p class="s num">{P.ref}: {ref || P.sinRef}</p>
    </div>
  </div>

  <div class="pay-split" style="margin-top:32px">
    <div class="card" style="display:flex;flex-direction:column;gap:13px">
      <p class="lbl">{P.porQue}</p>
      {[P.c1, P.c2, P.c3, P.c4].map((x) => (
        <div style="display:flex;gap:11px;align-items:flex-start">
          <Fragment set:html={icon('alert', 15, 'var(--or)')} />
          <p class="p" style="font-size:14px">{x}</p>
        </div>
      ))}
      <div style="border-top:1px solid var(--hair2);padding-top:12px">
        <div class="h3">{P.otros}</div>
        <p class="s" style="color:var(--l2);margin-top:4px">{P.otrosB}</p>
      </div>
    </div>
    <div style="display:flex;flex-direction:column;gap:10px">
      <a class="btn block" href="/pago" style="text-decoration:none">{P.reintentar}</a>
      <a class="btn ghost block" href="/soporte" style="text-decoration:none">{P.escribir}</a>
      <a class="btn ghost block" href="/" style="text-decoration:none">{P.volver}</a>
    </div>
  </div>
</Public>
