---
export const prerender = false;
import { getUser } from '../lib/session';
import { publicPrefs } from '../lib/prefs';
import { t } from '../lib/i18n';
import { grafo, org, curso } from '../lib/seo';
import { SITE, MARCA } from '../lib/site';
import { TOKENS, PUBLIC_BASE } from '../lib/theme-css';
import { icon } from '../lib/icons';
import PrefToggles from '../components/PrefToggles.astro';
import { gato, gatoCSS } from '../lib/cat';

const user = await getUser(Astro.request);
if (user) return Astro.redirect('/panel');

const { lang, langPref, theme } = publicPrefs(Astro.request);
const L = t(lang);
const P = L.pub.reg;
// La cuenta nueva nace con el idioma y el tema que el visitante ya eligió aquí.
const prefs = { lang: langPref, theme };
const canonical = new URL(Astro.url.pathname, SITE).href;
const jsonld = grafo(org());
---
<!doctype html>
<html lang={lang} data-theme={theme}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any">
  <title>{P.crear} · IA desde cero</title>
  <link rel="canonical" href={canonical}>
  <meta property="og:site_name" content={MARCA}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonical}>
  <script type="application/ld+json" is:inline set:html={jsonld}></script>
  <style is:global set:html={TOKENS + PUBLIC_BASE + gatoCSS('reg-trazo')}></style>
</head>
<body>
  <div class="pub-split">
    <section class="pub-pane">
      <a href="/" style="display:flex;align-items:center;gap:11px;color:var(--l1)">
        <span class="mark">IA</span>
        <span style="font:600 13px/1.2 var(--f)">IA desde cero</span>
        <span class="lbl" style="margin-left:6px">{L.pub.marca}</span>
      </a>
      <div style="margin-top:26px;display:flex;flex-direction:column;gap:20px">
        <h1 class="h1">{P.h1a}<br>{P.h1b}</h1>
        <p class="p" style="max-width:430px">{P.pitch}</p>
      </div>
      <div style="margin-top:auto;display:flex;flex-direction:column;gap:12px;border-top:1px solid var(--hair2);padding-top:22px">
        <div style="display:flex;gap:12px;align-items:flex-start"><Fragment set:html={icon('check', 18, 'var(--ok)')} /><p class="s" style="color:var(--l2)">{P.b1}</p></div>
        <div style="display:flex;gap:12px;align-items:flex-start"><Fragment set:html={icon('lock', 18, 'var(--ok)')} /><p class="s" style="color:var(--l2)">{P.b2}</p></div>
        <div style="display:flex;gap:12px;align-items:flex-start"><Fragment set:html={icon('refresh', 18, 'var(--ok)')} /><p class="s" style="color:var(--l2)">{P.b3}</p></div>
        <div class="trazo-anda" style="position:relative;height:96px;margin-top:10px">
          <div style="position:absolute;left:0;bottom:0" set:html={gato(96, 'carga', 'reg-trazo')}></div>
          <div class="card" style="position:absolute;left:62px;top:6px;padding:10px 12px;max-width:168px;transform:rotate(-6deg)">
            <p class="eb" style="color:var(--ac)">{L.trazo.paso1k}</p>
            <p class="s" style="color:var(--l1)">{L.trazo.paso1t}</p>
          </div>
        </div>
      </div>
    </section>

    <section class="pub-main">
      <div style="display:flex;justify-content:flex-end">
        <PrefToggles lang={langPref} theme={theme} labels={{ auto: L.pub.auto, dark: L.pub.oscuro, paper: L.pub.papel, langAria: L.pub.ariaIdioma, themeAria: L.pub.ariaTema }} />
      </div>
      <div style="flex:1;display:flex;align-items:center;justify-content:center">
        <form id="f" class="pub-card" style="gap:20px" novalidate>
          <div style="display:flex;flex-direction:column;gap:8px">
            <p class="eb">{P.eb}</p>
            <h2 class="h1" style="font-size:28px">{P.h2}</h2>
          </div>
          <div style="display:flex;flex-direction:column;gap:7px">
            <label class="lbl" for="name">{P.nombre}</label>
            <input class="input" id="name" name="name" autocomplete="name" placeholder={P.nombrePh} required>
          </div>
          <div style="display:flex;flex-direction:column;gap:7px">
            <label class="lbl" for="email">{P.correo}</label>
            <input class="input" id="email" name="email" type="email" autocomplete="email" placeholder="tu@correo.com" required>
          </div>
          <div style="display:flex;flex-direction:column;gap:7px">
            <label class="lbl" for="pass">{P.clave}</label>
            <input class="input" id="pass" name="password" type="password" autocomplete="new-password" placeholder={P.clavePh} required>
            <div class="meter"><div id="meter" style="height:4px;width:0;background:var(--rd);transition:width .2s,background .2s"></div></div>
            <p class="s" id="hint">{P.fMin}</p>
          </div>
          <div style="display:flex;flex-direction:column;gap:7px">
            <label class="lbl" for="pass2">{P.repetir}</label>
            <input class="input" id="pass2" type="password" autocomplete="new-password" placeholder={P.repetirPh} required>
          </div>
          <button class="btn block" id="go" type="submit">{P.crear}</button>
          <p class="s" style="text-align:center">{P.yaTienes} <a href="/login">{P.entrar}</a></p>
        </form>
      </div>
    </section>
  </div>
  <div id="toasts"></div>
  <script>
    import { montarAvisos } from '../lib/avisos';
    montarAvisos(document.documentElement.lang === 'en' ? 'Close' : 'Cerrar');
  </script>
  <script define:vars={{ P, prefs }}>
    const toast = (k, tt, b) => window.toast(k, tt, b);
    const fill = (str, n) => String(str).replace('{n}', n);
    const form = document.getElementById('f');
    const meter = document.getElementById('meter');
    const hint = document.getElementById('hint');
    const go = document.getElementById('go');

    const strength = (v) => {
      let s = 0;
      if (v.length >= 8) s++; if (v.length >= 12) s++;
      if (/[A-Z]/.test(v) && /[a-z]/.test(v)) s++;
      if (/\d/.test(v)) s++; if (/[^A-Za-z0-9]/.test(v)) s++;
      return Math.min(s, 4);
    };
    form.password.addEventListener('input', () => {
      const s = strength(form.password.value);
      meter.style.width = [0, 25, 50, 75, 100][s] + '%';
      meter.style.background = s <= 1 ? 'var(--rd)' : s === 2 ? 'var(--or)' : 'var(--ok)';
      hint.textContent = form.password.value.length < 8 ? P.fCorta : s <= 2 ? P.fFlojo : P.fBien;
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = form.name.value.trim(), email = form.email.value.trim(), password = form.password.value;
      if (name.length < 2) return toast('bad', P.eNombre, P.eNombreB);
      if (!/^[^@\s]+@[^@\s.]+\.[^@\s]{2,}$/.test(email)) return toast('bad', P.eCorreo, P.eCorreoB);
      if (password.length < 8) return toast('bad', P.eClave, P.eClaveB);
      if (password !== document.getElementById('pass2').value) return toast('bad', P.eDist, P.eDistB);
      go.disabled = true; go.textContent = P.creando;
      try {
        const res = await fetch('/api/auth/register', {
          method: 'POST', headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ name, email, password, lang: prefs.lang, theme: prefs.theme }),
        });
        const d = await res.json().catch(() => ({}));
        if (res.status === 201) {
          toast('ok', fill(P.tOk, name.split(' ')[0]), P.tOkB);
          setTimeout(() => location.assign('/panel'), 500);
          return;
        }
        if (res.status === 409) toast('warn', P.tDup, P.tDupB);
        else toast('bad', P.tErr, d.msg ?? P.tErrB);
      } catch {
        toast('bad', P.tRed, P.tRedB);
      } finally { go.disabled = false; go.textContent = P.crear; }
    });
  </script>
</body>
</html>
