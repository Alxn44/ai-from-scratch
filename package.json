{
  "name": "ia-desde-cero",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "setup": "pnpm --dir api install && pnpm --dir web install",
    "dev": "node scripts/dev.mjs",
    "stop:web": "pnpm --dir web exec astro dev stop || true",
    "seed": "pnpm --dir api seed",
    "db": "docker compose up -d db",
    "docker": "docker compose up --build",
    "stop": "pnpm run stop:web; docker compose down",
    "reset": "docker compose down -v && docker compose up -d db && pnpm --dir api seed",
    "test": "cd api && DATABASE_URL=${DATABASE_URL:-postgres://curso:curso@localhost:5432/curso} pnpm test",
    "test:aislamiento": "cd api && DATABASE_URL=${DATABASE_URL:-postgres://curso:curso@localhost:5432/curso} node test/aislamiento.mjs",
    "test:herramientas": "cd api && DATABASE_URL=${DATABASE_URL:-postgres://curso:curso@localhost:5432/curso} node test/herramientas.mjs",
    "ontologia": "node scripts/gen-ontologia.mjs",
    "ligas:cerrar": "node api/scripts/cerrar-ligas.mjs"
  }
}
